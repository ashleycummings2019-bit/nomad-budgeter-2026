---
layout: layouts/base.njk
pagination:
  data: cityCountryComparisons
  size: 1
  alias: comp
permalink: "/compare/city-country/{{ comp.slug }}/"
eleventyComputed:
  pageTitle: "{{ comp.city.name }} vs. {{ comp.country.name }}: 2026 Lifestyle & Tax Comparison"
  pageDescription: "Strategic analysis between {{ comp.city.name }} and {{ comp.country.name }}. Compare cost of living, tax efficiency, and 2026 digital nomad benefits."
---

{# Pre-calculate scores #}
{% set scoreCity = comp.city.score %}
{% set scoreCountry = ((1 - comp.country.tax) * 60 + 35) | round %}
{% if scoreCountry > 99 %}{% set scoreCountry = 99 %}{% endif %}

<div class="section-container mt-12 pb-24">
    {# Breadcrumbs #}
    <div class="mb-8 reveal">
        <a href="/" class="text-dim hover:text-white transition-colors">Home</a>
        <span class="mx-2 text-dim">/</span>
        <a href="/compare/" class="text-dim hover:text-white transition-colors">Compare</a>
        <span class="mx-2 text-dim">/</span>
        <span class="text-white font-semibold">{{ comp.city.name }} vs. {{ comp.country.name }}</span>
    </div>

    {# Strategic Header #}
    <div class="text-center mb-16 reveal">
        <div class="badge-2026 mb-6">
            <span class="pulse-dot"></span>
            2026 Lifestyle & Sovereign Arbitrage
        </div>
        <h1 class="aura-title mb-6">
            {{ comp.city.name }} <span class="text-dim" style="font-weight:300;">vs.</span> {{ comp.country.name }}
        </h1>
        <p class="text-dim mx-auto" style="max-width: 800px; font-size: 1.25rem;">
            Comparing the local lifestyle of <strong>{{ comp.city.name }}</strong> against the national benefits of <strong>{{ comp.country.name }}</strong>.
        </p>
    </div>

    {# Dashboard Header #}
    <div class="glass-panel p-10 mb-12 reveal">
        <div class="comparison-header-grid">
            {# City #}
            <div class="header-side text-center">
                <div class="aura-score mb-6 mx-auto" style="--score: {{ scoreCity }}; --score-color: var(--aura-primary);">
                    <span>{{ scoreCity }}</span>
                </div>
                <h2 class="h3 mb-2">{{ comp.city.name }}</h2>
                <div class="badge-2026 tag-success">Lifestyle Focus</div>
            </div>

            {# VS Middle #}
            <div class="header-vs">
                <div class="vs-circle">VS</div>
                <div class="vs-line"></div>
            </div>

            {# Country #}
            <div class="header-side text-center">
                <div class="aura-score mb-6 mx-auto" style="--score: {{ scoreCountry }}; --score-color: var(--aura-secondary);">
                    <span>{{ scoreCountry }}</span>
                </div>
                <h2 class="h3 mb-2">{{ comp.country.name }}</h2>
                <div class="badge-2026 tag-info">Tax Focus</div>
            </div>
        </div>
    </div>

    {# Core Metrics Grid #}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-16 reveal">
        <div class="glass-panel p-6 text-center">
            <span class="text-dim small block mb-2 uppercase font-bold tracking-tighter">Tax Rate</span>
            <div class="h4 mb-0" style="color: var(--aura-accent);">{{ comp.country.tax | percentInt }}</div>
        </div>
        <div class="glass-panel p-6 text-center">
            <span class="text-dim small block mb-2 uppercase font-bold tracking-tighter">Cost of Living</span>
            <div class="h4 mb-0" style="color: var(--aura-primary);">${{ comp.city.cost | localeString }}</div>
        </div>
        <div class="glass-panel p-6 text-center">
            <span class="text-dim small block mb-2 uppercase font-bold tracking-tighter">Internet Speed</span>
            <div class="h4 mb-0" style="color: var(--aura-secondary);">{{ comp.city.internet }} Mbps</div>
        </div>
        <div class="glass-panel p-6 text-center">
            <span class="text-dim small block mb-2 uppercase font-bold tracking-tighter">Safety Score</span>
            <div class="h4 mb-0" style="color: #f59e0b;">{{ comp.city.safety }}/100</div>
        </div>
    </div>

    {# Side-by-Side Deep Dive #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-24 reveal">
        {# City Focus #}
        <div class="glass-panel p-8">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-2xl bg-primary flex items-center justify-center text-2xl">🏙️</div>
                <div>
                    <h3 class="mb-0">{{ comp.city.name }} Lifestyle</h3>
                    <p class="text-dim small mb-0">{{ comp.city.region }}</p>
                </div>
            </div>
            
            <div class="price-pulse-card mb-8">
                <div class="flex-between mb-2">
                    <span class="text-dim">Nomad Budget:</span>
                    <span class="font-bold text-primary">${{ comp.city.cost | localeString }}/mo</span>
                </div>
                <div class="progress-track"><div class="progress-fill bg-primary" style="width: 75%"></div></div>
            </div>

            <h4 class="mb-4">Local Amenities</h4>
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white-5 p-4 rounded-xl border border-white-10">
                    <div class="text-dim small mb-1">Coworking</div>
                    <div class="font-bold">Excellent</div>
                </div>
                <div class="bg-white-5 p-4 rounded-xl border border-white-10">
                    <div class="text-dim small mb-1">Nightlife</div>
                    <div class="font-bold">Vibrant</div>
                </div>
                <div class="bg-white-5 p-4 rounded-xl border border-white-10">
                    <div class="text-dim small mb-1">Healthcare</div>
                    <div class="font-bold">Tier 1</div>
                </div>
                <div class="bg-white-5 p-4 rounded-xl border border-white-10">
                    <div class="text-dim small mb-1">Walkability</div>
                    <div class="font-bold">High</div>
                </div>
            </div>
        </div>

        {# Country Focus #}
        <div class="glass-panel p-8">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-2xl bg-secondary flex items-center justify-center text-2xl">🛡️</div>
                <div>
                    <h3 class="mb-0">{{ comp.country.name }} Framework</h3>
                    <p class="text-dim small mb-0">{{ comp.country.visaName }}</p>
                </div>
            </div>

            <div class="visa-intel-card mb-8">
                <div class="stat-row"><span>Flat Tax:</span> <strong class="text-accent">{{ comp.country.tax | percentInt }}</strong></div>
                <div class="stat-row"><span>Min. Income:</span> <strong>${{ comp.country.minIncomeMonthly | localeString }}/mo</strong></div>
                <div class="stat-row"><span>Visa Type:</span> <strong>{{ comp.country.taxType }}</strong></div>
                <div class="stat-row"><span>Processing:</span> <strong>{{ comp.country.processingTime }}</strong></div>
            </div>

            <h4 class="mb-4">Country Highlights</h4>
            <ul class="clean-list">
                {% for highlight in comp.country.highlights %}
                <li class="flex items-start gap-3 mb-3 text-dim">
                    <span class="text-secondary">✓</span> {{ highlight }}
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {# Call to Action #}
    <div class="glass-panel p-10 reveal text-center mb-24 border-accent">
        <h2 class="h3 mb-4">Relocation ROI Analysis</h2>
        <p class="text-dim mb-8 mx-auto" style="max-width: 600px;">
            Relocating to {{ comp.city.name }} under the {{ comp.country.visaName }} framework could save you 
            <strong>{{ (0.35 - comp.country.tax) | percentInt }}</strong> in tax compared to a standard EU residency.
        </p>
        <div class="flex justify-center gap-6 flex-wrap">
            <a href="/visas/{{ comp.country.slug }}/" class="aura-button">Apply for {{ comp.country.name }} Visa</a>
            <a href="/cities/{{ comp.city.slug }}/" class="aura-button-secondary">Explore {{ comp.city.name }} Guide</a>
        </div>
    </div>

    {# Related Comparisons #}
    <div class="pt-24 border-t border-white-5 reveal">
        <h2 class="text-center mb-12">More Strategic Comparisons</h2>
        <div class="partner-grid">
            {% for related in cityCountryComparisons | slice(0, 12) %}
                {% if related.slug != comp.slug %}
                <a href="/compare/city-country/{{ related.slug }}/" class="partner-card">
                    <div class="flex-between mb-4">
                        <span class="text-dim small font-bold">{{ related.city.name }}</span>
                        <span class="text-dim small font-bold">VS</span>
                        <span class="text-dim small font-bold">{{ related.country.name }}</span>
                    </div>
                    <p class="small text-dim mb-0">View Strategic Comparison →</p>
                </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
