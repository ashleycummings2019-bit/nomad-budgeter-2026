  {# ─── RELATED SHOWDOWNS ─── #}
  <div class="mb-16">
    <h2 class="aura-title mb-6">More City Showdowns</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;">
      {% set all_slugs = showdowns | keys %}
      {% for rel_slug in all_slugs %}
        {% if rel_slug != d.slug %}
        {% set r = showdowns[rel_slug] %}
        <a href="/compare/showdown/{{ r.slug }}/" class="glass-panel p-4" style="text-decoration:none;color:var(--text-main);display:flex;flex-direction:column;gap:6px;transition:all 0.2s;">
          <div style="font-size:1.2rem;">{{ r.emoji_a }}{{ r.emoji_b }}</div>
          <div style="font-weight:600;font-size:0.9rem;">{{ r.city_a }} vs {{ r.city_b }}</div>
          <div class="text-dim text-small">{{ r.subtitle }}</div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {# ─── LEAD MAGNET ─── #}
  {% include "partials/lead-magnet.njk" %}

  {# ─── SEO SILOS ─── #}
  <div class="mt-16">
    {% include "partials/seo-silos.njk" %}
  </div>
</div>

{# JSON-LD FAQPage for rich results #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in d.faqs %}
    {
      "@type": "Question",
      "name": "{{ faq.q | escape }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.a | escape }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
