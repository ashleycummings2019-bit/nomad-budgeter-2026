---
layout: layouts/base.njk
pageTitle: "Digital Nomad Comparison Engine: Cost of Living, Visas & Taxes"
pageDescription: "Compare cities and countries for digital nomads side-by-side. Our 2026 data engine breaks down cost of living, taxes, and visa requirements for global relocation."
pageSchema: |
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Digital Nomad Comparison Engine",
    "description": "Compare cities and countries for digital nomads side-by-side.",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ site.url }}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Compare",
          "item": "{{ site.url }}{{ page.url }}"
        }
      ]
    }
  }
permalink: /compare/
---

{% include "partials/breadcrumbs.njk" %}
<div class="section-container mt-16">
    <div class="text-center mb-16">
        <h1 class="aura-title large-title">Compare Nomad Hubs</h1>
        <p class="text-dim subtitle-text max-800 mx-auto mt-6">Explore our comprehensive database of city and country comparisons. Find the perfect digital nomad destination by comparing cost of living, visas, and tax benefits side-by-side.</p>
    </div>

    {# Themed Categories #}
    <div class="mb-24">
        <div class="grid-4 stack-on-mobile gap-6">
            {% for theme in comparisons.themes %}
            <div class="glass-panel p-6 theme-card text-center">
                <div class="theme-icon mb-4" style="font-size: 2.5rem;">{{ theme.emoji }}</div>
                <h3 class="aura-title mb-2" style="font-size: 1.2rem;">{{ theme.title }}</h3>
                <p class="text-dim text-small mb-4">{{ theme.description }}</p>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    {% for slug in theme.slugs %}
                        {% set found = false %}
                        {% for comp in comparisons.list %}
                            {% if comp.slug == slug %}
                                <a href="/compare/{{ slug }}/" class="text-link text-small">{{ comp.cityA.name }} vs {{ comp.cityB.name }}</a>
                                {% set found = true %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# City vs City Comparisons #}
    <div class="mb-24">
        <h2 class="aura-title mb-8 text-center">Top City vs. City Comparisons</h2>
        <div class="stack-grid">
        {% for comp in comparisons.list %}
            <a href="/compare/{{ comp.slug }}/" class="stack-item glass-panel hub-card">
                <div class="hub-icon">{{ comp.emoji | default('⚖️') }}</div>
                <div class="hub-info">
                    <div class="hub-name">{{ comp.cityA.name }} vs. {{ comp.cityB.name }}</div>
                    <div class="hub-desc">{{ comp.theme | default('Cost of Living & Taxes') }}</div>
                    <div class="arbitrage-badge" style="margin-top: 0.5rem; display: inline-block; padding: 0.2rem 0.5rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                        ${{ comp.arbitrageValue | localeString }}/mo Arbitrage
                    </div>
                </div>
            </a>
        {% endfor %}
        </div>
    </div>

    {# City vs Country Comparisons #}
    <div class="mb-24">
        <h2 class="aura-title mb-8 text-center">City vs. Country Comparisons</h2>
        <div class="stack-grid">
        {% for comp in cityCountryComparisons %}
            <a href="/compare/city-vs-country/{{ comp.slug }}/" class="stack-item glass-panel hub-card">
                <div class="hub-icon">🏙️</div>
                <div class="hub-info">
                    <div class="hub-name">{{ comp.city.name }} vs. {{ comp.country.name }}</div>
                    <div class="hub-desc">Compare City to National Average</div>
                </div>
            </a>
        {% endfor %}
        </div>
    </div>

    {# Country vs Country Comparisons #}
    <div class="mb-24">
        <h2 class="aura-title mb-8 text-center">Country vs. Country Comparisons</h2>
        <div class="stack-grid">
        {% for comp in countryComparisons %}
            <a href="/compare/country/{{ comp.slug }}/" class="stack-item glass-panel hub-card">
                <div class="hub-icon">🗺️</div>
                <div class="hub-info">
                    <div class="hub-name">{{ comp.countryA.name }} vs. {{ comp.countryB.name }}</div>
                    <div class="hub-desc">National Visas & Tax Frameworks</div>
                </div>
            </a>
        {% endfor %}
        </div>
    </div>
</div>

