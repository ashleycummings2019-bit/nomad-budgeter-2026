---
layout: layouts/base.njk
pageTitle: "Claim Your Nomad Arbitrage | Nomad Budgeter 2026"
pageDescription: "Welcome from social! Calculate your 2026 tax savings and cost of living arbitrage in seconds."
permalink: /go/
---

<style>
    :root {
        --viral-accent: #8b5cf6;
    }
    .viral-hero {
        padding: 4rem 1.5rem 2rem;
        text-align: center;
        background: radial-gradient(circle at top, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
    }
    .viral-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 100px;
        color: #a78bfa;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }
    .viral-title {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1rem;
        background: linear-gradient(to right, #fff, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .viral-subtitle {
        color: var(--text-dim);
        font-size: 1.1rem;
        max-width: 500px;
        margin: 0 auto 2.5rem;
    }
    .viral-cities-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 3rem;
    }
    .viral-city-card {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        text-align: left;
    }
    .viral-city-card h3 {
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }
    .viral-city-card .tax-gain {
        color: #10b981;
        font-weight: 700;
        font-size: 0.9rem;
    }
    .cta-container {
        position: sticky;
        bottom: 2rem;
        z-index: 100;
        padding: 0 1.5rem;
    }
    .floating-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
        padding: 1.25rem;
        background: var(--viral-accent);
        color: white;
        text-decoration: none;
        border-radius: 16px;
        font-weight: 700;
        box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.5);
        transition: transform 0.2s;
    }
    .floating-cta:active {
        transform: scale(0.98);
    }
</style>

