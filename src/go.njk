        </div>
        <div class="viral-city-card">
            <span style="font-size: 1.5rem;">🇪🇸</span>
            <h3>Valencia</h3>
            <div class="tax-gain">+ $1,150/mo</div>
        </div>
        <div class="viral-city-card">
            <span style="font-size: 1.5rem;">🇦🇪</span>
            <h3>Dubai</h3>
            <div class="tax-gain">+ $2,800/mo</div>
        </div>
        <div class="viral-city-card">
            <span style="font-size: 1.5rem;">🇹🇭</span>
            <h3>Bangkok</h3>
            <div class="tax-gain">+ $980/mo</div>
        </div>
    </div>
</section>

