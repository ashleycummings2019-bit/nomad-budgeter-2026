---
layout: layouts/base.njk
pageTitle: "Nomad Budgeter | Free Digital Nomad Tax & Cost of Living Calculator (2026)"
pageDescription: "Calculate your digital nomad tax rate, take-home pay, and cost of living in 45+ countries. Compare 2026 tax brackets, 0% tax havens, and visa programs instantly."
pageSchema: |
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "SoftwareApplication",
        "@id": "https://nomadbudgeter.com/#software",
        "name": "Nomad Budgeter - Global Digital Nomad Tax & Budget Calculator",
        "operatingSystem": "Web Browser",
        "applicationCategory": "FinanceApplication",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "featureList": [
          "Real-time 2026 tax estimates for 45+ countries",
          "Cost of living data integration",
          "Digital Nomad Visa tax rate lookup",
          "Multi-currency conversion support",
          "Monthly savings potential analysis"
        ],
        "dateModified": "2026-04-17"
      },
      {
        "@type": "HowTo",
        "name": "How to Calculate Your Digital Nomad Budget",
        "description": "Use Nomad Budgeter to estimate your net income, taxes, and cost of living in any global destination.",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter Your Income", "text": "Type your annual gross income in USD." },
          { "@type": "HowToStep", "position": 2, "name": "Choose Your Destination", "text": "Enter any city worldwide into the Target City field." },
          { "@type": "HowToStep", "position": 3, "name": "Review Your Results", "text": "Click 'Calculate My Budget' to see take-home pay, tax rate, and savings." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How are the 2026 digital nomad tax rates calculated?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Our 2026 tax estimates are based on current legislated tax laws for digital nomad visas, including special regimes like Spain's Beckham Law, Portugal's NHR successors, and the UAE's 0% personal income tax."
            }
          },
          {
            "@type": "Question",
            "name": "Which countries offer 0% tax for digital nomads in 2026?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Countries like UAE, Malaysia, and Bermuda offer 0% personal income tax for nomads. Other nations like Greece and Italy offer significant tax reductions (up to 50%) for qualified applicants under their 2026 nomad visa programs."
            }
          },
          {
            "@type": "Question",
            "name": "Is the cost of living data updated for 2026?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, our cost of living data is updated monthly and adjusted for 2026 inflation projections to ensure nomads have an accurate representation of their purchasing power in different global hubs."
            }
          }
        ]
      }
    ]
  }
permalink: /
---

{# Hero Section — First thing users see #}
<section id="hero-section" class="wa-hero">
    <div class="wa-hero__bg">
        <div class="aura-blob blob-1"></div>
        <div class="aura-blob blob-2"></div>
        <div class="wa-grid-overlay"></div>
    </div>

    <div class="wa-hero__content aura-container">
        <div class="grid-2 hero-split">
            <!-- Left Column: Copy & CTA -->
            <div class="hero-left">
                <div class="wa-hero__badge">
                    <span class="wa-badge-dot"></span>
                    <span>EXCLUSIVE 2026 GUIDE</span>
                </div>

                <h1 class="wa-hero__title">
                    Master the Global<br>
                    <span class="wa-title-gradient">Tax Arbitrage</span>
                </h1>

                <p class="wa-hero__subtitle">
                    Get our secret roadmap to saving <strong>$15,000+ per year</strong> in taxes by choosing the right digital nomad hub. Powered by live 2026 financial data.
                </p>

                <div class="hero-actions">
                    <div class="wa-lead-form">
                        <input type="email" id="lead-email" class="wa-lead-input" placeholder="Your best email address..." required>
                        <button type="button" id="send-guide-btn" class="wa-lead-btn action-btn">
                            <span class="wa-btn-icon">🚀</span>
                            Send Me The PDF
                        </button>
                    </div>
                    <div id="lead-success" class="wa-lead-success hidden" style="margin-bottom: 0.5rem; text-align: left;">
                        <span class="wa-success-icon">✅</span>
                        <span style="font-size: 0.85rem; color: var(--aura-primary);">Sent! Check your inbox (and spam).</span>
                    </div>
                    <p class="wa-lead-trust" style="text-align: left;">Join 12,402+ nomads optimizing their 2026 strategy.</p>
                </div>

                <div class="hero-secondary-actions">
                    <a href="#calculator-section" class="glass-btn-sm" onclick="document.querySelector('.inputs-panel')?.scrollIntoView({behavior:'smooth'});return false;">
                        📊 Open Calculator
                    </a>
                    <a href="/pricing/" class="glass-btn-sm wa-cta--pro" style="color: var(--aura-accent); border-color: rgba(245, 158, 11, 0.3);">
                        💎 Go Pro ($19)
                    </a>
                </div>

                <div class="wa-hero__featured">
                    <p style="text-align: left;">As featured in</p>
                    <div class="featured-logos">
                        <span>Forbes</span>
                        <span>TechCrunch</span>
                        <span>Nomad Capitalist</span>
                        <span>WIRED</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual / Mockup -->
            <div class="hero-right">
                <div class="hero-visual-stack">
                    <div class="glass-panel main-mockup">
                        <div class="mockup-header">
                            <div class="mockup-dots"><span></span><span></span><span></span></div>
                            <div class="mockup-title">Tax Savings Projection</div>
                        </div>
                        <div class="mockup-body">
                            <div class="mockup-stat">
                                <span class="stat-label">Net Income (Spain)</span>
                                <span class="stat-value text-green">+$24,500</span>
                            </div>
                            <div class="mockup-chart">
                                <div class="chart-bar bar-1"></div>
                                <div class="chart-bar bar-2"></div>
                                <div class="chart-bar bar-3"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Partner Card -->
                    <div class="glass-panel floating-card partner-card">
                        <div class="wa-partner-info">
                            <span class="wa-partner-badge">Partner Offer</span>
                            <h3>Blueground furnished apartments</h3>
                            <p>Save 5% on monthly stays with code <code class="wa-promo-code">NOMADBUDGETER</code></p>
                        </div>
                        <a href="{{ site.affiliates.blueground.url | affUrl('homepage') }}" target="_blank" class="wa-partner-link action-btn" style="padding: 0.5rem 1rem; font-size: 0.8rem; margin-top: 1rem; width: 100%; justify-content: center;">Claim Offer →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="wa-scroll-indicator" style="animation: none;">
        <span style="animation: pulseAura 2s infinite;">Scroll to calculate</span>
        <svg style="animation: float 2s ease-in-out infinite;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
</section>

<div class="app-container">
    {# Calculator Sidebar #}
    {% include "partials/calculator.njk" %}

    {# Results Panel (hidden until calculation) #}
    <section id="results-panel" class="glass-panel hidden">
