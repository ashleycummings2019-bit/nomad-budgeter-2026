<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include "partials/head.njk" %}
    {# Critical CSS — inline to eliminate render-blocking stylesheet #}
    <style>
    :root{--bg-dark:#09090b;--bg-surface:#18181b;--text-main:#f4f4f5;--text-dim:#a1a1aa;--aura-primary:#10b981;--aura-primary-rgb:16,185,129;--aura-secondary:#8b5cf6;--aura-accent:#f59e0b;--glass-border:rgba(255,255,255,0.08);--radius-md:16px;--font-main:'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;--font-heading:'Outfit',sans-serif;--transition-smooth:all .4s cubic-bezier(.4,0,.2,1)}
    *{margin:0;padding:0;box-sizing:border-box;-webkit-font-smoothing:antialiased}
    html{scroll-behavior:smooth}
    body{background:var(--bg-dark);color:var(--text-main);font-family:var(--font-main);line-height:1.6;overflow-x:hidden;min-height:100vh;position:relative}
    a{text-decoration:none;color:inherit}
    button{font-family:inherit;cursor:pointer}
    img{max-width:100%;height:auto}
    .aura-container{max-width:1200px;margin:0 auto;padding:0 2rem}
    .site-header{position:fixed;top:0;left:0;width:100%;z-index:1000;background:rgba(9,9,11,.4);border-bottom:1px solid rgba(255,255,255,.05);transform:translateZ(0);contain:layout style}
    .site-header.scrolled{background:rgba(9,9,11,.85);height:64px}
    .header-container{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.75rem 2rem;height:72px}
    .logo{display:flex;align-items:center;gap:.5rem;font-size:1.2rem;font-weight:800;font-family:var(--font-heading)}
    .wa-hero{position:relative;min-height:100vh;display:flex;align-items:center;padding:6rem 0 4rem;overflow:hidden}
    @media(max-width:768px){.aura-container{padding:0 1.25rem}body{padding-bottom:140px}.site-header{background:rgba(9,9,11,.92)}.wa-hero{padding:5rem 1.5rem 3rem;min-height:90vh}}
    </style>
    {# Full stylesheet — loaded async to not block first paint #}
    <link rel="preload" href="/css/index.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/css/index.css"></noscript>
    {% if '/blog' in page.url or '/post' in page.url %}
    <link rel="stylesheet" href="/css/blog.css">
    {% endif %}

    {# Google Analytics 4 — deferred to not block rendering #}
    <script>
      window.__NB_CONFIG__ = {
        clerkPubKey: "{{ site.apiKeys.clerkPubKey }}",
        stripeProUrl: "{{ site.stripe.pro }}",
        stripeBizUrl: "{{ site.stripe.biz }}"
      };
    </script>
</head>
<body>
    <div class="aura-blob blob-1"></div>
    <div class="aura-blob blob-2"></div>
    {% include "partials/cookie-banner.njk" %}
    {% include "partials/aura-modal.njk" %}
    {% include "partials/header.njk" %}
    {% include "partials/mobile-cta.njk" %}

    <noscript>
        <div style="background: #1e293b; color: #e2e8f0; padding: 2rem; text-align: center; font-family: system-ui, sans-serif;">
            <h2>JavaScript Required</h2>
            <p style="margin-top: 0.5rem; color: #94a3b8;">Nomad Budgeter requires JavaScript to calculate taxes, compare cities, and display live data. Please enable JavaScript in your browser settings.</p>
        </div>
    </noscript>

    <main id="main-content">
        {{ content | safe }}
    </main>

    {% include "partials/mobile-nav.njk" %}

    {% include "partials/footer.njk" %}

    <script src="/js/geo-currency.js" defer></script>
    <script src="/js/aura-ticker.js" defer></script>
    <script type="module" src="/js/main.js"></script>
    <script src="/js/capture-lead.js" defer></script>
    <script src="/js/auth.js" defer></script>

    {# Header scroll effect #}
    <script>
    (function() {
        var header = document.querySelector('.site-header');
        if (header) {
            var ticking = false;
            window.addEventListener('scroll', function() {
                if (!ticking) {
                    requestAnimationFrame(function() {
                        header.classList.toggle('scrolled', window.scrollY > 20);
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        }
    })();
    </script>

    {# Lazy-load GA4 + Clerk after first user interaction for performance #}
    <script>
    (function() {
        var loaded = false;
        function loadThirdParty() {
            if (loaded) return;
            loaded = true;

            // GA4
            var ga = document.createElement('script');
            ga.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}';
            ga.async = true;
            document.head.appendChild(ga);
            ga.onload = function() {
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                window.gtag = gtag;
                gtag('js', new Date());
                gtag('config', '{{ site.ga4 }}');
            };

            // Clerk
            var clerk = document.createElement('script');
            clerk.src = 'https://clerk.nomadbudgeter.com/npm/@clerk/clerk-js@latest/dist/clerk.browser.js';
            clerk.async = true;
            clerk.crossOrigin = 'anonymous';
            clerk.dataset.clerkPublishableKey = '{{ site.apiKeys.clerkPubKey }}';
            document.head.appendChild(clerk);
            clerk.onload = function() {
                var el = document.getElementById('header-user-btn');
                if (el && window.Clerk) {
                    try {
                        window.Clerk.mountUserButton(el, {
                            afterSignOutUrl: '/',
                            appearance: { elements: { userButtonAvatarBox: { width: '32px', height: '32px' } } }
                        });
                    } catch(e) {}
                }
            };
        }

        // Load on first interaction or after 4s idle
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function(evt) {
            window.addEventListener(evt, loadThirdParty, { once: true, passive: true });
        });
        setTimeout(loadThirdParty, 4000);
    })();
    </script>
</body>
</html>
