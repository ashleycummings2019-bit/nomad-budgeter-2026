<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include "partials/head.njk" %}
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/blog.css">

    {# Google Analytics 4 #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ site.ga4 }}');
    </script>

    {# Clerk Authentication #}
    <script
      async
      crossorigin="anonymous"
      data-clerk-publishable-key="{{ site.apiKeys.clerkPubKey }}"
      src="https://cdn.clerk.com/clerk.browser.js"
      type="text/javascript"
    ></script>

    {# Inject public config only — API keys handled server-side via /api/ proxies #}
    <script>
      window.__NB_CONFIG__ = {
        clerkPubKey: "{{ site.apiKeys.clerkPubKey }}"
      };
    </script>
</head>
<body>
    <div class="aura-blob blob-1"></div>
    <div class="aura-blob blob-2"></div>
    {% include "partials/cookie-banner.njk" %}
    {% include "partials/aura-modal.njk" %}
    {% include "partials/header.njk" %}
    {% include "partials/mobile-cta.njk" %}

    <main id="main-content">
        {{ content | safe }}
    </main>

    {% include "partials/mobile-nav.njk" %}

    {% include "partials/footer.njk" %}

    <script src="/js/geo-currency.js"></script>
    <script src="/js/aura-ticker.js"></script>
    <script type="module" src="/js/main.js"></script>
    <script src="/js/capture-lead.js"></script>
    <script src="/js/auth.js"></script>
</body>
</html>
