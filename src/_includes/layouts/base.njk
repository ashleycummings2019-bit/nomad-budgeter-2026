<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include "partials/head.njk" %}
    <link rel="stylesheet" href="/css/index.css">
    {% if '/blog' in page.url or '/post' in page.url %}
    <link rel="stylesheet" href="/css/blog.css">
    {% endif %}

    {# Google Analytics 4 #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ site.ga4 }}');
    </script>

    {# Clerk Authentication #}
    <script
      async
      crossorigin="anonymous"
      data-clerk-publishable-key="{{ site.apiKeys.clerkPubKey }}"
      src="https://clerk.nomadbudgeter.com/npm/@clerk/clerk-js@latest/dist/clerk.browser.js"
      type="text/javascript"
    ></script>

    {# Inject public config only — API keys handled server-side via /api/ proxies #}
    <script>
      window.__NB_CONFIG__ = {
        clerkPubKey: "{{ site.apiKeys.clerkPubKey }}",
        stripeProUrl: "{{ site.stripe.pro }}",
        stripeBizUrl: "{{ site.stripe.biz }}"
      };
    </script>
</head>
<body>
    <div class="aura-blob blob-1"></div>
    <div class="aura-blob blob-2"></div>
    {% include "partials/cookie-banner.njk" %}
    {% include "partials/aura-modal.njk" %}
    {% include "partials/header.njk" %}
    {% include "partials/mobile-cta.njk" %}

    <noscript>
        <div style="background: #1e293b; color: #e2e8f0; padding: 2rem; text-align: center; font-family: system-ui, sans-serif;">
            <h2>JavaScript Required</h2>
            <p style="margin-top: 0.5rem; color: #94a3b8;">Nomad Budgeter requires JavaScript to calculate taxes, compare cities, and display live data. Please enable JavaScript in your browser settings.</p>
        </div>
    </noscript>

    <main id="main-content">
        {{ content | safe }}
    </main>

    {% include "partials/mobile-nav.njk" %}

    {% include "partials/footer.njk" %}

    <script src="/js/geo-currency.js" defer></script>
    <script src="/js/aura-ticker.js" defer></script>
    <script type="module" src="/js/main.js"></script>
    <script src="/js/capture-lead.js" defer></script>
    <script src="/js/auth.js" defer></script>

    {# Header scroll effect + Clerk user button #}
    <script>
    (function() {
        // Scroll effect
        const header = document.querySelector('.site-header');
        if (header) {
            let ticking = false;
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        header.classList.toggle('scrolled', window.scrollY > 20);
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        }

        // Mount Clerk user button when available
        function mountClerkUser() {
            const el = document.getElementById('header-user-btn');
            if (!el) return;
            if (window.Clerk) {
                try {
                    window.Clerk.mountUserButton(el, {
                        afterSignOutUrl: '/',
                        appearance: { elements: { userButtonAvatarBox: { width: '32px', height: '32px' } } }
                    });
                } catch(e) { /* Clerk not fully loaded yet */ }
            } else {
                setTimeout(mountClerkUser, 500);
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', mountClerkUser);
        } else {
            mountClerkUser();
        }
    })();
    </script>
</body>
</html>
