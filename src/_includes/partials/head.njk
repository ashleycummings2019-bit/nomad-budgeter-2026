{# SEO Head Partial — Renders title, meta, OG tags, canonical, and JSON-LD #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&family=Outfit:wght@300;500;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&family=Outfit:wght@300;500;700;900&display=swap"></noscript>

{# Favicon & PWA #}
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌍</text></svg>" type="image/svg+xml">
<link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌍</text></svg>">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#09090b">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

{# Noscript fallback #}
<noscript>
    <style>.site-header,.mobile-tab-bar,.mobile-sticky-cta,.aura-blob{display:none!important}body{background:#0f172a;color:#e2e8f0;font-family:system-ui,sans-serif}</style>
</noscript>

<title>{{ pageTitle or title or (site.name + " | " + site.tagline) }}</title>
<meta name="description" content="{{ pageDescription or description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="author" content="{{ site.name }}">
<meta name="last-modified" content="{{ site.dataLastVerified }}">
<meta name="agd-partner-manual-verification" />
<meta name="google-site-verification" content="oeyAqxRXD2lk1vgFo4vW4jN_c87sUwkmkvMj6agt25k" />
<meta name="msvalidate.01" content="204A25B07C8EAD42723E25A4A4322E1F" />
<link rel="alternate" type="application/rss+xml" title="Nomad Budgeter Blog" href="{{ site.url }}/blog/feed.xml">

{# Open Graph #}
<meta property="og:title" content="{{ pageTitle or title or site.name }}">
<meta property="og:description" content="{{ pageDescription or description or site.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage | default('/img/og-main.jpg') }}">
<meta property="og:site_name" content="{{ site.name }}">

{# Twitter Card #}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@nomadbudgeter">
<meta name="twitter:title" content="{{ pageTitle or title or site.name }}">
<meta name="twitter:description" content="{{ pageDescription or description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage | default('/img/og-main.jpg') }}">

{# JSON-LD Structured Data — Page-specific blocks injected via pageSchema variable #}
{% if pageSchema %}
<script type="application/ld+json">
{{ pageSchema | safe }}
</script>
{% endif %}

{# Default Organization Schema on every page #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}/img/logo.png",
  "sameAs": [
    "https://twitter.com/nomadbudgeter",
    "https://linkedin.com/company/nomadbudgeter"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "{{ site.email }}",
    "contactType": "customer support"
  }
}
</script>
