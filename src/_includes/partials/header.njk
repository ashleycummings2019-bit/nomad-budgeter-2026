{# Site Header — Premium Glassmorphic Navigation #}
<header class="site-header glass-panel" role="banner">
    <div class="header-container">
        <a href="/" class="logo" aria-label="Nomad Budgeter Home">
            <img src="/assets/images/logo.png" alt="Nomad Budgeter Logo" width="120" height="40" style="max-height: 40px; width: auto; object-fit: contain;" fetchpriority="high">
        </a>
        
        <nav class="main-nav" role="navigation" aria-label="Main navigation">
            <a href="/cities/" class="nav-link">Cities</a>
            <a href="/visas/" class="nav-link">Visas</a>
            <a href="/compare/" class="nav-link">Compare</a>
            <a href="{{ site.affiliates.blueground.url | affUrl('nav') }}" class="nav-link highlight-link" target="_blank">Housing</a>
            <a href="/blog/" class="nav-link">Blog</a>
        </nav>

        <div class="header-actions">
            <a href="/pricing/" id="header-go-pro" class="pro-tag-btn">
                <span class="pro-tag">PRO</span>
                Unlock Reports
            </a>
            
            <button class="mobile-nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
                <span class="hamburger"></span>
            </button>
        </div>
    </div>
</header>

