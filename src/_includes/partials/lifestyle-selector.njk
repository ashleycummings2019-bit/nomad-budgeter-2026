<div class="lifestyle-selector-wrapper reveal" style="animation-delay: 0.3s">
    <div class="lifestyle-selector-container">
        <div class="lifestyle-selector" id="lifestyleSelector">
            <button class="lifestyle-btn" data-tier="budget" title="Hostels, local markets, and public transit">
                <span class="emoji">🎒</span> Budget
            </button>
            <button class="lifestyle-btn active" data-tier="comfort" title="Private studio, dining out 3x/week, and co-working">
                <span class="emoji">🏠</span> Comfort
            </button>
            <button class="lifestyle-btn" data-tier="luxury" title="Premium condo, daily fine dining, and private transport">
                <span class="emoji">🥂</span> Luxury
            </button>
        </div>
        <p id="lifestyleDesc" class="text-dim text-xs mt-3 text-center">Estimating for a comfortable nomad lifestyle.</p>
    </div>
</div>
