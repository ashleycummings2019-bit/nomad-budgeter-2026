{# Breadcrumbs Partial - Boosts SEO and Navigation #}
<nav class="breadcrumbs section-container" aria-label="Breadcrumb" style="margin-top: 1rem; margin-bottom: 1rem; font-size: 0.85rem; color: var(--text-dim);">
  <ol style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
    <li style="display: flex; align-items: center;">
      <a href="/" style="color: var(--text-dim); text-decoration: none;">Home</a>
      <span style="margin-left: 0.5rem; margin-right: 0.5rem;">/</span>
    </li>
    
    {% if city and not comp %}
    <li style="display: flex; align-items: center;">
      <a href="/visas/{{ city.countrySlug }}/" style="color: var(--text-dim); text-decoration: none;">{{ city.country }}</a>
      <span style="margin-left: 0.5rem; margin-right: 0.5rem;">/</span>
    </li>
    <li style="display: flex; align-items: center;">
      {% if isCalculatorPage %}
      <a href="/cities/{{ city.slug }}/" style="color: var(--text-dim); text-decoration: none;">{{ city.name }}</a>
      <span style="margin-left: 0.5rem; margin-right: 0.5rem;">/</span>
      {% else %}
      <span style="color: var(--aura-primary); font-weight: 500;">{{ city.name }} Profile</span>
      {% endif %}
    </li>
    {% if isCalculatorPage %}
    <li style="display: flex; align-items: center;">
      <span style="color: var(--aura-primary); font-weight: 500;">Calculator</span>
    </li>
    {% endif %}
    {% endif %}

    {% if country and not comp %}
    <li style="display: flex; align-items: center;">
      <a href="/visas/{{ country.slug }}/" style="color: var(--aura-primary); text-decoration: none; font-weight: 500;">{{ country.name }} Visa Guide</a>
    </li>
    {% endif %}

    {% if comp %}
    <li style="display: flex; align-items: center;">
      <a href="/compare/" style="color: var(--text-dim); text-decoration: none;">Compare</a>
      <span style="margin-left: 0.5rem; margin-right: 0.5rem;">/</span>
    </li>
    <li style="display: flex; align-items: center;">
      <span style="color: var(--aura-primary); font-weight: 500;">
        {% if comp.cityA %}
          {{ comp.cityA.name }} vs {{ comp.cityB.name }}
        {% elif comp.countryA %}
          {{ comp.countryA.name }} vs {{ comp.countryB.name }}
        {% elif comp.city %}
          {{ comp.city.name }} vs {{ comp.country.name }}
        {% endif %}
      </span>
    </li>
    {% endif %}
  </ol>
</nav>

{# Breadcrumb Schema is now handled in page-specific frontmatter for maximum accuracy #}
{# But we keep a fallback here if not provided, or simply rely on frontmatter #}
