---
layout: layouts/dashboard.njk
title: "Agent Swarm Feed"
---

<div class="swarm-container">
    {# ═══ SWARM HEADER & STATS ═══ #}
    <div class="swarm-stats-row">
        <div class="dashboard-card stat-card">
            <div class="stat-label">Pending Review</div>
            <div class="stat-value" id="stat-pending">0</div>
        </div>
        <div class="dashboard-card stat-card">
            <div class="stat-label">Audited Today</div>
            <div class="stat-value" id="stat-audited">0</div>
        </div>
        <div class="dashboard-card stat-card">
            <div class="stat-label">System Confidence</div>
            <div class="stat-value" id="stat-confidence">98%</div>
        </div>
    </div>

    {# ═══ FEED SECTION ═══ #}
    <div class="dashboard-card feed-card">
        <div class="card-header">
            <div>
                <h3 class="premium-text-gradient">🤖 Intelligence Queue</h3>
                <p class="text-dim">Real-time findings from the Researcher and Auditor agents.</p>
            </div>
            <div class="feed-filters">
                <select id="filter-status" class="premium-select">
                    <option value="pending">Pending Only</option>
                    <option value="all">All Findings</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>
        </div>

        <div id="swarm-feed-list" class="swarm-feed-list">
            <div class="loading-state">
                <div class="aura-spinner"></div>
                <p>Connecting to Swarm backend...</p>
            </div>
        </div>
    </div>
</div>

<script src="/js/swarm-feed.js"></script>

<style>
.swarm-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.swarm-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
}

.stat-card {
    padding: 1.5rem !important;
    text-align: center;
}

.stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
}

.stat-value {
    font-size: 2.5rem;
    font-weight: 900;
    color: #fff;
}

.feed-card {
    min-height: 500px;
}

.swarm-feed-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
}

.finding-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    transition: all 0.3s ease;
}

.finding-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateX(4px);
}

.finding-type-icon {
    width: 48px;
    height: 48px;
    background: rgba(139, 92, 246, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.finding-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.finding-location {
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
}

.finding-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.4;
}

.finding-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
}

.confidence-tag {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    font-weight: 700;
}

.status-badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: 800;
}

.status-pending { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
.status-approved { background: rgba(16, 185, 129, 0.1); color: #10b981; }
.status-rejected { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

.finding-actions {
    display: flex;
    gap: 0.75rem;
}

.btn-approve {
    background: #10b981;
    color: #fff;
    border: none;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-approve:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }

.btn-reject {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
}

.btn-reject:hover { background: rgba(239, 68, 68, 0.2); }

.finding-diff {
    margin-top: 1rem;
    background: rgba(0,0,0,0.2);
    border-radius: 12px;
    padding: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
}

.diff-old { color: #ef4444; text-decoration: line-through; margin-bottom: 4px; }
.diff-new { color: #10b981; font-weight: 600; }

.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--text-dim);
}

.premium-select {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    outline: none;
}
</style>
