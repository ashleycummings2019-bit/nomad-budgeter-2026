            </div>
            <p class="text-dim" style="font-size:0.65rem;margin-top:8px;opacity:0.5;">We may earn a commission at no extra cost to you.</p>
        </div>
    </div>

    {# Quick Insights #}
    <div class="dashboard-card insights aura-glow-violet">
        <div class="card-header">
            <h3 class="premium-text-gradient">AI Intelligence</h3>
            <span class="badge-ai">PRO</span>
        </div>
        <div class="insights-scroll">
            <div class="insight-card">
                <div class="insight-visual">
                    <div class="visual-circle"></div>
