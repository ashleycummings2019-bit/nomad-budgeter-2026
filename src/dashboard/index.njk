                <a href="{{ site.affiliates.wise.url | affUrl('dashboard') }}" target="_blank" rel="sponsored noopener" class="upsell-card">
                    <span class="upsell-icon">💸</span>
                    <div>
                        <div class="upsell-name">Wise</div>
                        <div class="upsell-desc">Transfer funds before you move</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.blueground.url | affUrl('dashboard') }}" target="_blank" rel="sponsored noopener" class="upsell-card">
                    <span class="upsell-icon">🏠</span>
                    <div>
                        <div class="upsell-name">Blueground</div>
                        <div class="upsell-desc">Furnished apartments, flexible leases</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.interactiveBrokers.url | affUrl('dashboard') }}" target="_blank" rel="sponsored noopener" class="upsell-card">
                    <span class="upsell-icon">📈</span>
                    <div>
                        <div class="upsell-name">Interactive Brokers</div>
                        <div class="upsell-desc">Invest from anywhere globally</div>
                    </div>
