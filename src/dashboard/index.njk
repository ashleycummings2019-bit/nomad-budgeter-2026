                        <span class="trip-badge current">Current</span>
                    </div>
                    <div class="trip-dates">
                        <span>Jan 15, 2026</span>
                        <span class="date-arrow">&rarr;</span>
                        <span>Present</span>
                    </div>
                    <div class="trip-days">142 Days</div>
                </div>
            </div>

            <div class="trip-log-item">
                <div class="trip-status">
                    <div class="status-dot dimmed"></div>
                </div>
                <div class="trip-info-card">
                    <div class="trip-meta">
                        <img src="https://flagcdn.com/w40/ae.png" alt="UAE" class="mini-flag" width="40" height="30">
                        <span class="trip-country">United Arab Emirates</span>
                        <span class="trip-badge">Completed</span>
                    </div>
                    <div class="trip-dates">
                        <span>Dec 1, 2025</span>
                        <span class="date-arrow">&rarr;</span>
                        <span>Jan 10, 2026</span>
                    </div>
                    <div class="trip-days">41 Days</div>
                </div>
            </div>
        </div>
    </div>

    {# Business Tier API Access - Only visible if .is-business-tier is on body #}
    <div class="dashboard-card business-only api-access-card">
        <div class="card-header">
            <h3>B2B API Access</h3>
            <span class="badge-gold">BUSINESS</span>
        </div>
        <p class="text-dim">Your high-fidelity city data feed is active. Use your registered email as the <code>x-user-email</code> header.</p>
        <div class="api-details">
            <div class="api-field">
                <label>Endpoint</label>
                <div class="copy-box">
                    <code>https://www.nomadbudgeter.com/api/v1/cities</code>
                </div>
            </div>
            <div class="api-field">
                <label>Auth Method</label>
                <div class="copy-box">
                    <span>Clerk JWT (Bearer Token)</span>
                </div>
            </div>
        </div>
        <a href="/docs/api" class="link-aura">View API Documentation &rarr;</a>
    </div>

    {# Upgrade Callout - Viral 2026 Edition #}
    <div class="dashboard-card upgrade-callout free-pro-only">
        <div class="upgrade-inner">
            <div class="upgrade-content">
                <div class="aura-icon-wrapper">
                    <span class="aura-icon">⚡️</span>
                    <div class="aura-pulse"></div>
                </div>
                <div>
                    <div class="badge-premium">LIMITED ACCESS</div>
                    <h3 class="heading-premium">Unlock Enterprise Intelligence</h3>
                    <p class="text-premium">Integrate real-time global tax & COL data directly into your business workflow.</p>
                </div>
            </div>
            <button class="btn-premium-gold" onclick="location.href='/pricing'">
                <span>Upgrade to Business</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </button>
        </div>
    </div>
</div>

{# Add Trip Modal #}
<div id="add-trip-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Log New Trip</h3>
            <button class="btn-close">&times;</button>
        </div>
        <form id="add-trip-form">
            <div class="form-group">
                <label for="trip-country">Country</label>
                <input type="text" id="trip-country" placeholder="e.g. Spain" required>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="trip-entry">Entry Date</label>
                    <input type="date" id="trip-entry" required>
                </div>
                <div class="form-group">
                    <label for="trip-exit">Exit Date</label>
                    <input type="date" id="trip-exit" required>
                </div>
            </div>
            <button type="submit" class="btn-primary-sm">Save Log Entry</button>
        </form>
    </div>
</div>

<style>
.monitor-grid {
    display: grid;
    grid-template-columns: 1.6fr 1.4fr;
    grid-template-rows: auto auto auto;
    gap: 1.5rem;
}

/* ─── Days Tracker Centrepiece ─── */
.days-tracker-hero {
    box-shadow: 0 0 50px -15px rgba(16, 185, 129, 0.15);
    border-top: 2px solid rgba(16, 185, 129, 0.2);
}

.tracker-summary {
    display: flex;
    gap: 1.5rem;
    margin: 1.5rem 0;
}

.ts-stat {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    min-width: 100px;
}

.ts-num {
    font-size: 2rem;
    font-weight: 900;
    line-height: 1;
    color: #fff;
}

.ts-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-top: 4px;
}

.ts-alert .ts-num { color: #ef4444; }

.tracker-grid-inner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.tracker-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 1.25rem 1.5rem;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
}

.tracker-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -10px rgba(0,0,0,0.4);
}

.tc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
}

.tc-country {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.tc-flag {
    width: 32px;
    height: 22px;
    border-radius: 4px;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.tc-name {
    font-weight: 700;
    font-size: 0.95rem;
}

.tc-current {
    color: #10b981;
    font-size: 0.75rem;
    font-weight: 600;
}

.tc-threshold-label {
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.tc-days-big {
    font-size: 2rem;
    font-weight: 900;
    line-height: 1;
    color: #fff;
}

.tc-days-unit {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-dim);
    margin-left: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

/* Progress bar */
.tc-bar-track {
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 100px;
    overflow: visible;
    position: relative;
    margin-bottom: 0.75rem;
}

.tc-bar-fill {
    height: 100%;
    border-radius: 100px;
    transition: width 1s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
}

.tc-bar-pulse {
    animation: barPulse 2s ease-in-out infinite;
}

@keyframes barPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.tc-bar-marker {
    position: absolute;
    top: -4px;
    width: 2px;
    height: 14px;
    background: rgba(245, 158, 11, 0.5);
    border-radius: 2px;
}

.tc-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Badges */
.tc-badge {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 8px;
    text-align: center;
    letter-spacing: 0.02em;
}

.tc-badge-red {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
}

.tc-badge-amber {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.2);
}

.tc-projected {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    padding: 8px 12px;
    background: rgba(0,0,0,0.2);
    border-radius: 8px;
    border-left: 3px solid rgba(255,255,255,0.1);
    line-height: 1.5;
    color: var(--text-dim);
}

/* Empty state */
.tracker-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 2rem;
    color: var(--text-dim);
}

.tracker-empty h3 {
    color: #fff;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

/* Pro gate overlay */
.pro-gate-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to bottom, transparent 0%, rgba(9,9,11,0.95) 40%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
    border-radius: 0 0 32px 32px;
    z-index: 10;
}

.pro-gate-content {
    text-align: center;
    max-width: 400px;
}

.pro-gate-content h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.pro-gate-content p {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.6;
}

.pro-gate-badge {
    display: inline-block;
    background: linear-gradient(90deg, #fbbf24, #f59e0b);
    color: #000;
    font-size: 0.7rem;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
}

/* Contextual Affiliate Upsell */
.tracker-upsell {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, rgba(16,185,129,0.04), rgba(139,92,246,0.04));
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px;
}

.upsell-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
}

.upsell-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    color: var(--text-main);
    transition: all 0.2s;
}

.upsell-card:hover {
    background: rgba(255,255,255,0.06);
    transform: translateY(-1px);
    border-color: rgba(16,185,129,0.2);
}

.upsell-icon { font-size: 1.3rem; flex-shrink: 0; }
.upsell-name { font-weight: 600; font-size: 0.85rem; }
.upsell-desc { font-size: 0.7rem; color: var(--text-dim); line-height: 1.3; }

.dashboard-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(40px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 2rem;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
    animation: cardEntrance 1s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.dashboard-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.06), transparent 40%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
}

.dashboard-card:hover::after { opacity: 1; }

.aura-glow-emerald { box-shadow: 0 0 40px -15px rgba(16, 185, 129, 0.2); }
.aura-glow-violet { box-shadow: 0 0 40px -15px rgba(139, 92, 246, 0.2); }

.premium-text-gradient {
    background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    letter-spacing: -0.02em;
}

/* Residency Gauge */
.tracker-layout {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin: 1.5rem 0;
}

.gauge-container {
    position: relative;
    width: 160px;
    height: 160px;
}

.residency-gauge {
    transform: rotate(-90deg);
}

.gauge-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 8;
}

.gauge-progress {
    fill: none;
    stroke: url(#gauge-gradient);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dasharray 1s ease-in-out;
}

.gauge-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
}

.gauge-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 900;
    color: #fff;
    line-height: 1;
}

.gauge-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-dim);
    letter-spacing: 0.1em;
}

.current-location {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
}

.premium-flag {
    width: 50px;
    height: 34px;
    border-radius: 6px;
    object-fit: cover;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
}

.location-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
}

.visa-badge {
    font-size: 0.75rem;
    color: var(--aura-primary);
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
}

.residency-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
}

.stat-item {
    display: flex;
    flex-direction: column;
}

.stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--text-dim);
    letter-spacing: 0.05em;
}

.stat-value {
    font-size: 1.1rem;
    font-weight: 700;
}

.insight-pill {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    font-size: 0.85rem;
    display: inline-block;
    border: 1px solid rgba(245, 158, 11, 0.1);
}

/* AI Insights */
.insights-scroll {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
}

.insight-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: all 0.3s ease;
}

.insight-card:hover {
    background: rgba(255, 255, 255, 0.04);
    transform: translateX(5px);
}

.insight-visual {
    position: relative;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
}

.visual-circle {
    position: absolute;
    width: 100%; height: 100%;
    border: 2px solid var(--aura-secondary);
    border-radius: 50%;
    opacity: 0.2;
    animation: pulseAura 3s infinite;
}

.insight-emoji {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.2rem;
}

.btn-shimmer {
    width: 100%;
    background: rgba(139, 92, 246, 0.1);
    color: var(--aura-secondary);
    border: 1px solid rgba(139, 92, 246, 0.2);
    padding: 0.8rem;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.btn-shimmer::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.2), transparent);
    animation: shimmer 4s infinite;
}

/* Trip Timeline */
.trip-timeline {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.trip-log-item {
    display: flex;
    gap: 1.5rem;
}

.trip-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 20px;
}

.status-dot {
    width: 12px;
    height: 12px;
    background: var(--aura-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--aura-primary);
}

.status-dot.dimmed {
    background: var(--text-dim);
    box-shadow: none;
    opacity: 0.5;
}

.status-line {
    width: 2px;
    flex-grow: 1;
    background: linear-gradient(to bottom, var(--aura-primary), transparent);
    opacity: 0.3;
}

.trip-info-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 1.25rem;
    flex-grow: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.trip-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.mini-flag {
    width: 24px;
    border-radius: 3px;
}

.trip-country {
    font-weight: 700;
}

