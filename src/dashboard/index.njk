                    <p>Estimated 2026 Tax Savings: <strong class="text-emerald">$14,200</strong></p>
                </div>
            </div>
        </div>
        <button class="btn-shimmer">Generate Full Report</button>
    </div>

    {# Travel History #}
    <div class="dashboard-card history">
        <div class="card-header">
            <h3 class="premium-text-gradient">Travel Logs</h3>
            <button class="btn-add-trip" id="btn-open-modal">
                <span class="plus-icon">+</span>
                <span>Add Log</span>
            </button>
        </div>
        
        <div class="trip-timeline">
            {# Mock current trip for viral feel #}
            <div class="trip-log-item active">
                <div class="trip-status">
                    <div class="status-dot"></div>
                    <div class="status-line"></div>
                </div>
