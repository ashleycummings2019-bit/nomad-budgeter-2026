        /* ═══ TOAST ═══ */
        .toast{position:fixed;bottom:2rem;right:2rem;background:#ef4444;color:#fff;padding:12px 20px;border-radius:12px;font-size:.9rem;font-weight:600;z-index:999;display:none;animation:slideUp .3s ease}
        .toast.show{display:block}
        @keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

        /* ═══ RESPONSIVE ═══ */
        @media(max-width:768px){
