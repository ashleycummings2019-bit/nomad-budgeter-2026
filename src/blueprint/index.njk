        .chapters{max-width:900px;margin:0 auto;padding:5rem 2rem}
        .chapters h2{font-family:var(--font);font-size:2rem;font-weight:900;color:var(--white);text-align:center;margin-bottom:.75rem}
        .chapters .section-sub{text-align:center;color:var(--dim);margin-bottom:3rem;font-size:1.05rem}
        .ch-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}
        .ch-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:1.5rem;transition:all .3s;position:relative;overflow:hidden}
        .ch-card:hover{border-color:rgba(251,191,36,.15);transform:translateY(-3px)}
        .ch-card .ch-num{font-size:.7rem;font-weight:800;color:var(--gold);letter-spacing:2px;margin-bottom:.5rem}
        .ch-card h3{font-family:var(--font);font-size:1.1rem;font-weight:700;color:var(--white);margin-bottom:.5rem}
        .ch-card p{font-size:.85rem;color:var(--dim);line-height:1.5}

        /* ═══ CTA STRIP ═══ */
        .cta-strip{background:linear-gradient(135deg,rgba(251,191,36,.08),rgba(139,92,246,.05));border-top:1px solid rgba(251,191,36,.1);border-bottom:1px solid rgba(251,191,36,.1);padding:4rem 2rem;text-align:center}
        .cta-strip h2{font-family:var(--font);font-size:1.8rem;font-weight:900;color:var(--white);margin-bottom:.5rem}
        .cta-strip p{color:var(--dim);margin-bottom:2rem;font-size:1.05rem}
