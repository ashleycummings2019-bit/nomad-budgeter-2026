<script>
(function() {
    const FORM_TOP = document.getElementById('leadForm');
    const FORM_BTM = document.getElementById('leadFormBottom');
    const EMAIL_TOP = document.getElementById('emailInput');
    const EMAIL_BTM = document.getElementById('emailInputBottom');
    const BTN_TOP = document.getElementById('submitBtn');
    const BTN_BTM = document.getElementById('submitBtnBottom');
    const SUCCESS = document.getElementById('successState');
    const TOAST = document.getElementById('toast');

    // Check if already subscribed
    if (localStorage.getItem('nb_lead_captured')) {
        FORM_TOP.classList.add('hide');
        SUCCESS.classList.add('show');
    }

    function showToast(msg, isError) {
        TOAST.textContent = msg;
        TOAST.style.background = isError ? '#ef4444' : '#10b981';
        TOAST.classList.add('show');
        setTimeout(() => TOAST.classList.remove('show'), 4000);
    }

    function validateEmail(e) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);
    }

    async function handleSubmit(email, btn) {
        if (!validateEmail(email)) {
            showToast('Please enter a valid email address.', true);
            return;
        }
        const origText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending...';

        try {
            const res = await fetch(['/api', 'capture-lead'].join('/'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, source: 'Geo-Arbitrage Blueprint Landing Page' })
            });
            const data = await res.json();

            if (res.ok) {
                localStorage.setItem('nb_lead_captured', email);
                // Track conversion in GA4
                if (window.gtag) {
                    gtag('event', 'generate_lead', {
                        event_category: 'Lead Magnet',
                        event_label: 'Geo-Arbitrage Blueprint',
                        value: 1
                    });
                }
                FORM_TOP.classList.add('hide');
                SUCCESS.classList.add('show');
                FORM_BTM.innerHTML = '<p style="color:#10b981;font-weight:700;font-size:1.1rem;">✅ Check above — your download is ready!</p>';
                showToast('Success! Your blueprint is ready to download.', false);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                showToast(data.error || 'Something went wrong. Try again.', true);
                btn.disabled = false;
                btn.textContent = origText;
            }
        } catch (err) {
            // Offline fallback — still let them through
            localStorage.setItem('nb_lead_captured', email);
            FORM_TOP.classList.add('hide');
            SUCCESS.classList.add('show');
            showToast('You\'re in! Download your blueprint now.', false);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }

    FORM_TOP.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSubmit(EMAIL_TOP.value.trim(), BTN_TOP);
    });

    FORM_BTM.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSubmit(EMAIL_BTM.value.trim(), BTN_BTM);
    });
})();
</script>

