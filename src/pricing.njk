<style>
.pricing-container {
    padding-top: 8rem;
    padding-bottom: 8rem;
}

.pricing-header {
    text-align: center;
    margin-bottom: 6rem;
}

.gradient-text {
    background: linear-gradient(135deg, var(--aura-primary), var(--aura-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* Billing Toggle */
.billing-toggle-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 3rem;
}

.toggle-label {
    font-weight: 700;
    color: var(--text-dim);
    transition: var(--transition-smooth);
}

.toggle-label.active {
    color: #fff;
}

.billing-toggle {
    width: 60px;
    height: 32px;
    background: rgba(255,255,255,0.1);
    border-radius: 100px;
    padding: 4px;
    cursor: pointer;
    position: relative;
    border: 1px solid var(--glass-border);
}

.toggle-switch {
    width: 22px;
    height: 22px;
    background: var(--aura-primary);
    border-radius: 50%;
    transition: var(--transition-bounce);
    box-shadow: 0 0 10px rgba(var(--aura-primary-rgb), 0.5);
}

.billing-toggle.annual .toggle-switch {
    transform: translateX(28px);
    background: var(--aura-secondary);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
}

.discount-badge {
    background: rgba(16, 185, 129, 0.1);
    color: var(--aura-primary);
    padding: 2px 8px;
    border-radius: 100px;
    font-size: 0.7rem;
    margin-left: 4px;
    border: 1px solid rgba(16, 185, 129, 0.2);
}

/* Pricing Grid */
.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 8rem;
}

@media (max-width: 1024px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 500px; margin-left: auto; margin-right: auto; }
}

.pricing-card {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 32px;
    padding: 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--transition-smooth);
    overflow: hidden;
}

.pricing-card:hover {
    transform: translateY(-12px) scale(1.02);
    border-color: rgba(255,255,255,0.2);
    box-shadow: 0 30px 60px -12px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.05);
}

.card-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    pointer-events: none;
    z-index: 0;
}

.pricing-card.featured {
    border: 2px solid var(--aura-primary);
    background: rgba(24, 24, 27, 0.8);
    z-index: 10;
}

.pricing-card.featured::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 34px;
    padding: 2px;
    background: linear-gradient(135deg, var(--aura-primary), transparent, var(--aura-primary));
    animation: rotate 8s linear infinite;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
}

.business-card::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 34px;
    padding: 2px;
    background: linear-gradient(135deg, var(--aura-secondary), transparent, var(--aura-secondary));
    animation: rotate 6s linear infinite reverse;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.popular-tag {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    background: var(--aura-primary);
    color: #000;
    font-weight: 800;
    font-size: 0.7rem;
    padding: 4px 12px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.card-tier {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
}

.card-price {
    font-size: 4.5rem;
    font-weight: 900;
    font-family: var(--font-heading);
    margin-bottom: 1rem;
    line-height: 1;
}

.card-price span {
    font-size: 1.25rem;
    color: var(--text-dim);
    font-weight: 500;
    margin-left: 4px;
}

.card-description {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    height: 3.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.mockup-preview {
    margin-bottom: 2.5rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    background: #000;
    height: 160px;
}

.mockup-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: var(--transition-smooth);
}

.pricing-card:hover .mockup-preview img {
    opacity: 1;
    transform: scale(1.1);
}

.card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem 0;
    flex-grow: 1;
}

.card-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    color: var(--text-main);
}

.check {
    color: var(--aura-primary);
    font-weight: 900;
}

/* Buttons */
.btn-primary, .btn-secondary, .btn-premium {
    padding: 1.25rem;
    border-radius: 16px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    font-size: 1.1rem;
    transition: var(--transition-smooth);
    border: none;
    cursor: pointer;
}

.btn-primary {
    background: var(--aura-primary);
    color: #000;
    box-shadow: 0 10px 25px rgba(var(--aura-primary-rgb), 0.3);
}

.btn-secondary {
    background: rgba(255,255,255,0.05);
    color: #fff;
    border: 1px solid var(--glass-border);
}

.btn-premium {
    background: linear-gradient(135deg, var(--aura-secondary), var(--aura-primary));
    color: #fff;
    box-shadow: 0 10px 25px rgba(139, 92, 246, 0.3);
    position: relative;
    overflow: hidden;
}

.btn-premium::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
    );
    animation: shimmer 3s infinite;
}

.btn-primary:hover, .btn-premium:hover {
    transform: scale(1.02);
    box-shadow: 0 15px 35px rgba(0,0,0,0.4);
}

/* Feature Matrix */
.feature-matrix-section {
    margin-bottom: 8rem;
}

.matrix-header {
    text-align: center;
    margin-bottom: 4rem;
}

.matrix-header p {
    color: var(--text-dim);
    font-size: 1.2rem;
}

.matrix-wrapper {
    padding: 0;
    overflow: hidden;
}

.matrix-table {
    width: 100%;
    border-collapse: collapse;
}

.matrix-table th {
    padding: 2.5rem 2rem;
    text-align: left;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    border-bottom: 1px solid var(--glass-border);
}

.matrix-table td {
    padding: 1.75rem 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    font-weight: 600;
}

.matrix-table tr:hover td {
    background: rgba(255,255,255,0.02);
}

.matrix-group td {
    background: rgba(255,255,255,0.03);
    color: var(--aura-primary);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--glass-border);
}

/* Footer */
.trust-badges {
    text-align: center;
    border-top: 1px solid var(--glass-border);
    padding-top: 4rem;
}

.trust-badges p {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    margin-bottom: 2rem;
}

.badge-grid {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
}

.badge-grid span {
    font-weight: 700;
    color: #fff;
    opacity: 0.5;
    transition: var(--transition-smooth);
}

.badge-grid span:hover {
    opacity: 1;
    color: var(--aura-primary);
}

.enterprise-badge {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    background: rgba(139, 92, 246, 0.2);
    color: var(--aura-primary);
    font-weight: 800;
    font-size: 0.7rem;
    padding: 4px 12px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(139, 92, 246, 0.3);
}

.business-card {
    border: 1px solid rgba(139, 92, 246, 0.3) !important;
}

.business-card:hover {
    box-shadow: 0 30px 60px -12px rgba(139, 92, 246, 0.2);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('billing-toggle');
    const proPrice = document.getElementById('price-pro');
    const businessPrice = document.getElementById('price-business');
    const labels = [document.getElementById('label-monthly'), document.getElementById('label-annual')];

    toggle.addEventListener('click', () => {
        const isAnnual = toggle.classList.toggle('annual');
        
        // Update active labels
        labels[0].classList.toggle('active', !isAnnual);
        labels[1].classList.toggle('active', isAnnual);

        // Update prices with a small animation
        const updatePrice = (el) => {
            const newPrice = isAnnual ? el.dataset.annual : el.dataset.monthly;
            el.style.opacity = '0';
            setTimeout(() => {
                el.innerHTML = `$${newPrice}<span>/mo</span>`;
                el.style.opacity = '1';
            }, 150);
        };

        updatePrice(proPrice);
        updatePrice(businessPrice);
    });

    // Reveal animations on scroll
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
});
</script>

