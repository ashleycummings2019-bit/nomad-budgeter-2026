---
layout: layouts/base.njk
pagination:
  data: cities
  size: 1
  alias: city
permalink: "/cities/{{ city.slug }}/"
eleventyComputed:
  pageTitle: "{{ city.name }} Digital Nomad Tax & Cost of Living Calculator (2026)"
  pageDescription: "Calculate your nomad budget in {{ city.name }}, {{ city.country }}. {{ city.visa }} with {{ city.tax | percentInt }} tax rate. Is {{ city.name }} worth it in 2026? Find out with our expert tax analysis and cost of living breakdown."
  prefillCity: "{{ city.name }}"
  pageSchema: |
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Place",
          "name": "{{ city.name }}",
          "description": "{{ pageDescription }}",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "{{ city.country }}"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is the cost of living in {{ city.name }} for digital nomads?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The estimated monthly cost of living in {{ city.name }} for a digital nomad is approximately ${{ city.col | localeString }}. This includes mid-range accommodation, local food, and basic co-working expenses."
              }
            },
            {
              "@type": "Question",
              "name": "What is the tax rate for nomads in {{ city.name }}?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nomads in {{ city.name }} typically pay an effective tax rate of {{ city.tax | percentInt }} under the {{ city.visa }}. This makes it a highly {{ 'efficient' if city.tax < 10 else 'standard' }} destination for tax arbitrage."
              }
            },
            {
              "@type": "Question",
              "name": "Is there a digital nomad visa for {{ city.name }}?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, {{ city.name }} is served by the {{ city.visa }}. To qualify, you generally need a minimum monthly income of ${{ city.visaMinIncome | localeString }}."
              }
            }
          ]
        }
      ]
    }
---

{% include "partials/breadcrumbs.njk" %}

{# City Hero Section #}
<div class="city-hero-wrapper">
    {% if city.external_image_url %}
    <div class="city-hero-bg" style="background-image: url('{{ city.external_image_url | vimg(1200, 80) }}')"></div>
    {% endif %}
    <div class="city-hero-overlay"></div>
    
    <div class="city-hero section-container">
        <div class="badge-2026 mb-4">
            <span class="badge-dot"></span>
            Verified {{ site.year }} Market Data
        </div>
        <h1 class="aura-title large-title">{{ city.name }} Nomad Tax<br>& Budget Calculator</h1>
        <p class="text-dim subtitle-text">{{ city.country }} · {{ city.visa }} · {{ city.tax | percentInt }} Nomad Tax Rate</p>

        <div class="city-highlights mt-8">
            {% for highlight in city.highlights %}
            <div class="highlight-tag reveal" style="animation-delay: {{ loop.index * 0.1 }}s">
                <span style="font-size: 1.2rem;">⚡</span>
                {{ highlight }}
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{# City Introduction #}
<div class="section-container mt-16">
    <div class="expert-analysis glass-panel p-8">
        <p class="text-main">{{ city.intro }}</p>

        {% if city.expertNotes %}
        <div class="expert-verdict mt-8">
            <div class="verdict-header">
                <span class="verdict-icon">💡</span>
                <span class="verdict-title">Expert Verdict: {{ city.name }} 2026</span>
            </div>
            <div class="verdict-body">
                {{ city.expertNotes }}
            </div>
        </div>
        {% endif %}

        {% include "partials/lifestyle-selector.njk" %}


        {# Key Stats Grid #}
        <div class="metric-grid mt-8">
            <div class="metric-card">
                <div class="metric-label">Monthly Cost of Living</div>
                <div class="metric-value highlight"><span class="nb-price" data-usd="{{ city.col }}">{{ city.col | usd }}</span></div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Average Rent (1BR Center)</div>
                <div class="metric-value"><span class="nb-price" data-usd="{{ city.rent }}">{{ city.rent | usd }}</span></div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Nomad Visa Tax Rate</div>
                <div class="metric-value {% if city.tax == 0 %}positive-text{% endif %}">{{ city.tax | percentInt }}</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Min. Annual Income</div>
                <div class="metric-value"><span class="nb-price" data-usd="{{ city.visaMinIncome * 12 }}">{{ (city.visaMinIncome * 12) | usd }}</span></div>
            </div>
        </div>

        {# Nomad Score Panel #}
        <div class="score-panel mt-8">
            <div class="metric-label">Aura Financial Score</div>
            <div class="score-value highlight">{{ city.score }}/100</div>
            <p class="text-dim text-sm">Based on tax efficiency, CoL, and 2026 quality of life indices.</p>
        </div>
    </div>
    
    {# Expert Market Intelligence #}
    {% include "partials/expert-breakdown.njk" %}

    {# Relocation Roadmap #}
    {% include "partials/tax-roadmap.njk" %}
</div>

{# ━━━ LIVE LOCAL PRICES (Pulse Data) ━━━ #}
{% if city.prices_usd %}
<div class="section-container mt-16">
    <div class="glass-panel p-8">
        <div class="flex-between mb-6">
            <h2 class="aura-title">Live Prices in {{ city.name }}</h2>
            {% if city.pulse_updated %}
            <span class="badge-2026 pulse-badge">
                <span class="badge-dot pulse-dot"></span>
                Updated {{ city.exchangeRateDate }}
            </span>
            {% endif %}
        </div>

        {% if city.exchangeRate and city.currency != "USD" %}
        <div class="exchange-rate-bar mb-6">
            <span class="rate-label">💱 Today's Rate</span>
            <span class="rate-value">1 USD = {{ city.exchangeRate }} {{ city.currency }}</span>
        </div>
        {% endif %}

        <div class="price-grid">
            <div class="price-card">
                <div class="price-emoji">☕</div>
                <div class="price-info">
                    <div class="price-item-name">Cappuccino</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.cappuccino }}">{{ city.prices_usd.cappuccino | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.cappuccino }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="price-card">
                <div class="price-emoji">🍽️</div>
                <div class="price-info">
                    <div class="price-item-name">Budget Meal</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.mealCheap }}">{{ city.prices_usd.mealCheap | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.mealCheap }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="price-card">
                <div class="price-emoji">🍺</div>
                <div class="price-info">
                    <div class="price-item-name">Local Beer</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.beerLocal }}">{{ city.prices_usd.beerLocal | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.beerLocal }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="price-card">
                <div class="price-emoji">🥛</div>
                <div class="price-info">
                    <div class="price-item-name">Milk (1 Liter)</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.milk1L }}">{{ city.prices_usd.milk1L | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.milk1L }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="price-card">
                <div class="price-emoji">🍗</div>
                <div class="price-info">
                    <div class="price-item-name">Chicken Breast (1kg)</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.chickenBreast1kg }}">{{ city.prices_usd.chickenBreast1kg | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.chickenBreast1kg }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="price-card">
                <div class="price-emoji">💻</div>
                <div class="price-info">
                    <div class="price-item-name">Coworking (Day)</div>
                    <div class="price-value"><span class="nb-price" data-usd="{{ city.prices_usd.coworkingDay }}">{{ city.prices_usd.coworkingDay | usdPrecise }}</span></div>
                    {% if city.prices_local and city.currency != "USD" %}
                    <div class="price-local">{{ city.prices_local.coworkingDay }} {{ city.currency }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <p class="text-dim text-sm mt-4" style="font-style: italic;">
            Prices reflect {{ site.year }} averages updated via live exchange rates.
            <span class="user-currency-note" style="display:none;"> Converted to <strong class="user-currency-name"></strong> for your convenience.</span>
        </p>
    </div>
</div>
{% endif %}

{# Calculator Widget #}
<div class="app-container mt-16">
    {% set prefillCity = city.name %}
    {% include "partials/calculator.njk" %}

    <section id="results-panel" class="glass-panel hidden">
        <div class="results-header">
            <div class="header-info">
                <h2 class="aura-title">Personalized Analysis</h2>
                <div class="header-meta">
                    <p id="city-badge" class="city-badge">{{ city.name }}, {{ city.country }}</p>
                    <span class="meta-dot"></span>
                    <p class="trust-indicator">
                        <span class="badge-dot pulse-dot"></span>
                        <span id="live-nomads-count">...</span> nomads analyzing {{ city.name }} live
                    </p>
                </div>
            </div>
            <div class="aura-score" id="aura-ring">
                <span id="aura-value">{{ city.score }}</span>
            </div>
        </div>

        <div class="metric-grid">
            <div class="metric-card">
                <div class="metric-label">Take-Home Pay (Monthly)</div>
                <div class="metric-value highlight" id="res-net-monthly">$0</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Effective Tax Rate</div>
                <div class="metric-value" id="res-tax-rate">0%</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Cost of Living Index</div>
                <div class="metric-value" id="res-col-index">High</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Monthly Savings Potential</div>
                <div class="metric-value positive" id="res-savings">$0</div>
            </div>
        </div>

        <div id="visa-roi-card" class="metric-card roi-tracker hidden mt-6">
            <div class="flex-between mb-4">
                <div class="roi-info">
                    <div class="metric-label accent-color">Visa ROI Tracker</div>
                    <p class="roi-desc">Time to recover visa & setup costs via tax savings.</p>
                </div>
                <div class="roi-stats">
                    <div class="metric-value positive" id="res-payback">0 Months</div>
                    <div class="roi-yearly-savings" id="res-roi-savings">+$0 / yr</div>
                </div>
            </div>
            <a href="https://citizenremote.com/?ref=nomadbudgeter" target="_blank" rel="sponsored noopener" id="visa-cta" class="action-btn w-full accent-bg">Apply for {{ city.name }} Visa →</a>
        </div>

        {# Success Stack #}
        <div class="success-stack-section mt-8">
            <h3 class="section-subtitle">Your {{ city.name }} Success Stack</h3>
            <div class="stack-grid">
                <a href="{{ site.affiliates.safetywing.url }}" target="_blank" rel="sponsored noopener" class="stack-item glass-panel">
                    <div class="stack-icon">🛡️</div>
                    <div class="stack-info">
                        <div class="stack-name">SafetyWing</div>
                        <div class="stack-desc">Global Health Cover</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.wise.url }}" target="_blank" rel="sponsored noopener" class="stack-item glass-panel">
                    <div class="stack-icon">💸</div>
                    <div class="stack-info">
                        <div class="stack-name">Wise</div>
                        <div class="stack-desc">Borderless Banking</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.remote.url }}" target="_blank" rel="sponsored noopener" class="stack-item glass-panel">
                    <div class="stack-icon">💼</div>
                    <div class="stack-info">
                        <div class="stack-name">Remote.com</div>
                        <div class="stack-desc">Payroll &amp; Compliance</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.nomadlist.url }}" target="_blank" rel="sponsored noopener" class="stack-item glass-panel">
                    <div class="stack-icon">🌍</div>
                    <div class="stack-info">
                        <div class="stack-name">Nomad List</div>
                        <div class="stack-desc">City &amp; Community</div>
                    </div>
                </a>
                <a href="{{ site.affiliates.lexidy.url }}" target="_blank" rel="sponsored noopener" class="stack-item glass-panel">
                    <div class="stack-icon">⚖️</div>
                    <div class="stack-info">
                        <div class="stack-name">Lexidy</div>
                        <div class="stack-desc">Visa Legal Experts</div>
                    </div>
                </a>
            </div>
        </div>

        <div class="metric-card commentary-box mt-6">
            <div class="metric-label">Budget Commentary</div>
            <p id="aura-commentary" class="commentary-text"></p>
        </div>

        {# Pro Report (Premium View) #}
        {% include "partials/pro-report.njk" %}

        {# Pro Report Upsell #}
        <div id="pro-upsell" class="glass-panel upsell-panel mt-6">
            <div class="upsell-container">
                <div class="upsell-content">
                    <div class="badge-2026 upsell-badge">PREMIUM REPORT</div>
                    <h3 class="upsell-title">Unlock {{ city.name }} Deep-Dive</h3>
                    <ul class="upsell-features">
                        <li>Detailed 2026 Tax Optimization Strategy</li>
                        <li>Local Apartment & Utility Estimates</li>
                        <li>Nomad Community & Co-working Heatmap</li>
                        <li>Direct Visa Lawyer Contact List</li>
                    </ul>
                    <div class="upsell-footer">
                        {% set currentTier = pricing.getCountryTier(city.country) %}
                        {% set currentPrice = pricing.tiers[currentTier].price %}
                        <div class="upsell-price"><span class="nb-price" data-usd="{{ currentPrice }}">{{ currentPrice | usd }}</span></div>
                        <button id="unlock-pro-btn" class="action-btn upsell-btn" data-price="{{ currentPrice }}">Unlock Pro →</button>
                    </div>
                </div>
                <div class="upsell-visual">
                    <img src="{{ '/assets/images/pro-mockup.png' | vimg(640, 80) }}" alt="Nomad Budgeter Pro Report Mockup" class="pro-mockup" loading="lazy" decoding="async">
                </div>
            </div>
        </div>

        <div class="trust-badge mt-8">
            <span>📊 Tax data last verified: {{ site.dataLastVerified }}</span>
            <span>🤖 Human-verified for {{ site.year }} compliance.</span>
        </div>

        {# Lead Magnet #}
        {% include "partials/lead-magnet.njk" %}
    </section>

    {# Tax Roadmap & Relocation Toolkit (Strategic Automation) #}
    <div class="section-container mt-16 reveal">
        <div class="grid-2 gap-8">
            <div class="roadmap-wrapper">
                {% include "partials/tax-roadmap.njk" %}
            </div>
            <div class="toolkit-wrapper">
                {% include "partials/relocation-toolkit.njk" %}
            </div>
        </div>
    </div>

    {# Tax Competitors (Internal Linking & SEO) #}
    <section class="section-container mt-24 reveal">
        <div class="flex-between mb-12">
            <div>
                <h2 class="aura-title mb-2">Tax Competitors</h2>
                <p class="text-dim">Looking for a better deal? These cities offer similar or lower taxes than {{ city.name }}.</p>
            </div>
            <a href="/cities/" class="text-link">View all cities &rarr;</a>
        </div>
        
        <div class="competitor-grid">
            {% set competitors = cities | selectattr("tax", "le", city.tax) | rejectattr("slug", "equalto", city.slug) %}
            {% for comp in competitors | slice(0, 4) %}
            <a href="/cities/{{ comp.slug }}/" class="competitor-card glass-panel aura-hover-glow">
                <div class="comp-top">
                    <span class="comp-name">{{ comp.name }}</span>
                    <span class="comp-flag">{% if comp.code == "PT" %}🇵🇹{% elif comp.code == "ES" %}🇪🇸{% elif comp.code == "AE" %}🇦🇪{% elif comp.code == "ID" %}🇮🇩{% elif comp.code == "GE" %}🇬🇪{% else %}📍{% endif %}</span>
                </div>
                <div class="comp-stats">
                    <div class="comp-stat">
                        <span class="stat-label">Tax Rate</span>
                        <span class="stat-value highlight">{{ comp.tax | percentInt }}</span>
                    </div>
                    <div class="comp-stat">
                        <span class="stat-label">Monthly Cost</span>
                        <span class="stat-value">${{ comp.col | localeString }}</span>
                    </div>
                </div>
                <div class="comp-benefit">
                    {% if comp.tax < city.tax %}
                    <span class="benefit-tag positive">Save {{ ((city.tax - comp.tax) * 100) | round }}%</span>
                    {% else %}
                    <span class="benefit-tag">Better Value</span>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
    </section>

    {# ━━━ THE SHOWDOWN: SIDE-BY-SIDE ━━━ #}
    <div class="section-container mt-24">
        <h2 class="aura-title text-center mb-12">The {{ site.year }} Financial Showdown</h2>
        
        <div class="showdown-grid">
            {# Primary City #}
            <div class="showdown-card primary-hub glass-panel reveal">
                <div class="showdown-badge">CURRENT FOCUS</div>
                <div class="showdown-header">
                    <div class="hub-emoji">{{ city.emoji | default('📍') }}</div>
                    <div class="hub-meta">
                        <h3>{{ city.name }}</h3>
                        <p>{{ city.country }}</p>
                    </div>
                </div>
                <div class="showdown-metrics">
                    <div class="s-metric">
                        <span>Nomad Tax</span>
                        <strong>{{ city.tax | percentInt }}</strong>
                    </div>
                    <div class="s-metric">
                        <span>Rent (1BR)</span>
                        <strong>{{ city.rent | usd }}</strong>
                    </div>
                    <div class="s-metric">
                        <span>Quality Score</span>
                        <strong>{{ city.score }}/100</strong>
                    </div>
                </div>
                <div class="showdown-verdict">
                    <p>{{ city.intro | truncate(80) }}</p>
                </div>
            </div>

            <div class="showdown-vs">VS</div>

            {# Comparison Target (Dynamic suggested city) #}
            {% set compTarget = null %}
            {% for other in cities %}
                {% if other.slug != city.slug and not compTarget %}
                    {% if other.country == city.country or (other.col > city.col * 0.8 and other.col < city.col * 1.2) %}
                        {% set compTarget = other %}
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% if compTarget %}
            <div class="showdown-card target-hub glass-panel reveal">
                <div class="showdown-badge secondary">SUGGESTED ALT</div>
                <div class="showdown-header">
                    <div class="hub-emoji">{{ compTarget.emoji | default('📍') }}</div>
                    <div class="hub-meta">
                        <h3>{{ compTarget.name }}</h3>
                        <p>{{ compTarget.country }}</p>
                    </div>
                </div>
                <div class="showdown-metrics">
                    <div class="s-metric">
                        <span>Nomad Tax</span>
                        <strong>{{ compTarget.tax | percentInt }}</strong>
                    </div>
                    <div class="s-metric">
                        <span>Rent (1BR)</span>
                        <strong>{{ compTarget.rent | usd }}</strong>
                    </div>
                    <div class="s-metric">
                        <span>Quality Score</span>
                        <strong>{{ compTarget.score }}/100</strong>
                    </div>
                </div>
                <div class="showdown-verdict">
                    <p>{{ compTarget.intro | truncate(80) }}</p>
                </div>
                <a href="/compare/city/{{ city.slug }}-vs-{{ compTarget.slug }}/" class="action-btn-sm mt-4">Full Side-by-Side →</a>
            </div>
            {% endif %}
        </div>
    </div>

    {# Similar Destinations Section #}
    <div class="section-container mt-24">
        <div class="flex-between mb-8">
            <h2 class="aura-title">Explore Similar Destinations</h2>
            <a href="/" class="view-all-link">Back to Map →</a>
        </div>
        <div class="stack-grid">
            {% set count = 0 %}
            {% for otherCity in cities %}
                {% if otherCity.slug != city.slug and count < 4 %}
                    {% if otherCity.country == city.country or (otherCity.col > city.col * 0.8 and otherCity.col < city.col * 1.2) %}
                        {% set count = count + 1 %}
                        <a href="/cities/{{ otherCity.slug }}/" class="stack-item glass-panel hub-card">
                            <div class="hub-icon">{{ otherCity.emoji | default('📍') }}</div>
                            <div class="hub-info">
                                <div class="hub-name">{{ otherCity.name }}</div>
                                <div class="hub-desc">{{ otherCity.country }} · {{ otherCity.tax | percentInt }} Tax</div>
                            </div>
                        </a>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
    </div>

    {# Related Comparisons #}
    <div class="section-container mt-24">
        <h2 class="aura-title text-center mb-8">Compare {{ city.name }} with Other Hubs</h2>
        
        {# Quick Comparison Widget #}
        <div class="glass-panel p-8 mb-12 text-center">
            <h3 class="section-subtitle mb-4">Select a city to compare costs & taxes</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
                {# Dynamic Comparison Logic: Same country or similar CoL #}
                {% set suggestedComparisons = [] %}
                {% for other in cities %}
                    {% if other.slug != city.slug and suggestedComparisons.length < 6 %}
                        {% if other.country == city.country or (other.col > city.col * 0.85 and other.col < city.col * 1.15) %}
                            {% set _ = suggestedComparisons.push(other) %}
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {# Fallbacks if list is short #}
                {% if suggestedComparisons.length < 3 %}
                    {% for other in cities %}
                        {% if other.slug != city.slug and other not in suggestedComparisons and suggestedComparisons.length < 6 %}
                            {% if other.continent == city.continent %}
                                {% set _ = suggestedComparisons.push(other) %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% for qCity in suggestedComparisons %}
                    <a href="/compare/city/{{ city.slug }}-vs-{{ qCity.slug }}/" class="glass-btn-sm aura-hover-lift" style="padding: 0.75rem 1.25rem; border-radius: 50px;">
                        <span style="opacity: 0.7; font-size: 0.9rem;">{{ qCity.emoji | default('📍') }}</span>
                        vs. {{ qCity.name }}
                    </a>
                {% endfor %}
            </div>
        </div>

        <div class="stack-grid">
            {% set compCount = 0 %}
            {% for comp in comparisons %}
                {% if (comp.cityA.slug == city.slug or comp.cityB.slug == city.slug) and compCount < 4 %}
                    {% set compCount = compCount + 1 %}
                    <a href="/compare/city/{{ comp.slug }}/" class="stack-item glass-panel hub-card">
                        <div class="hub-icon">{{ comp.emoji }}</div>
                        <div class="hub-info">
                            <div class="hub-name">{{ comp.cityA.name }} vs. {{ comp.cityB.name }}</div>
                            <div class="hub-desc">{{ comp.theme }}</div>
                        </div>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

<div class="section-container mt-16">
    {% include "partials/relocation-toolkit.njk" %}
    {% include "partials/seo-silos.njk" %}
</div>
{% endblock %}
