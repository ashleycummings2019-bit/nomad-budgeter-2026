---
layout: layouts/base.njk
pageTitle: "Top Digital Nomad Cities 2026 | Tax Rates & Cost of Living"
pageDescription: "Compare the best digital nomad cities in 2026. View live cost of living, rent prices, tax rates, and Aura scores for top remote work hubs globally."
permalink: /cities/
---

{% include "partials/breadcrumbs.njk" %}

<div class="section-container mt-16 text-center">
    <div class="badge-2026 mb-4" style="display: inline-block;">
        <span class="badge-dot"></span> Verified 2026 Data
    </div>
    <h1 class="aura-title large-title" style="font-size: 3.5rem;">Global Nomad Cities</h1>
    <p class="text-dim subtitle-text max-w-2xl mx-auto mt-4">
        Explore our curated list of top digital nomad hubs. Compare local living costs, rent, and nomad tax rates to find your perfect 2026 destination.
    </p>
</div>

<div class="section-container mt-16 mb-24">
    <div class="partner-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {% for city in cities | sort(attribute="name") %}
        <a href="/cities/{{ city.slug }}/" class="glass-panel aura-hover-glow" style="padding: 1.5rem; display: flex; flex-direction: column; text-decoration: none; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                <div>
                    <h2 style="font-size: 1.5rem; margin: 0; color: white;">{{ city.name }}</h2>
                    <p style="color: var(--text-dim); margin: 0; font-size: 0.9rem;">{{ city.country }}</p>
                </div>
                <div style="font-size: 1.5rem;">{{ city.emoji | default('📍') }}</div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: rgba(255,255,255,0.05); padding: 0.75rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.25rem;">Tax Rate</div>
                    <div style="color: white; font-weight: bold; font-size: 1.1rem;">{{ city.tax | percentInt }}</div>
                </div>
                <div style="background: rgba(255,255,255,0.05); padding: 0.75rem; border-radius: 8px; text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.25rem;">Cost of Living</div>
                    <div style="color: white; font-weight: bold; font-size: 1.1rem;">${{ city.col | localeString }}</div>
                </div>
            </div>
            
            <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 0.85rem; color: var(--text-dim);">
                    Score: <span style="color: #10b981; font-weight: bold;">{{ city.score }}/100</span>
                </div>
                <span style="color: var(--aura-primary); font-size: 0.9rem; font-weight: bold;">View Guide →</span>
            </div>
        </a>
        {% endfor %}
    </div>
</div>

<div class="section-container mt-16 mb-16">
    {% include "partials/seo-silos.njk" %}
</div>
