---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ site.url }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ site.url }}/trends/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    <url>
        <loc>{{ site.url }}/compare/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    {% for city in cities %}
    <url>
        <loc>{{ site.url }}/cities/{{ city.slug }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
{% endfor %}
    {% for comp in comparisons.list %}
    <url>
        <loc>{{ site.url }}/compare/city/{{ comp.slug }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    {% endfor %}
    {% for country in countries %}
    <url>
        <loc>{{ site.url }}/visas/{{ country.slug }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    {% endfor %}
    {% for comp in countryComparisons %}
    <url>
        <loc>{{ site.url }}/compare/country/{{ comp.slug }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {% endfor %}
    {% for comp in cityCountryComparisons %}
    <url>
        <loc>{{ site.url }}/compare/city-country/{{ comp.slug }}/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {% endfor %}
    <url>
        <loc>{{ site.url }}/privacy/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>
    <url>
        <loc>{{ site.url }}/disclaimer/</loc>
        <lastmod>{% sitemapDate %}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>
</urlset>

