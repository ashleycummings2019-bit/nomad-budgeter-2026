{
  "$schema": "https://opencode.ai/config.json",
  "models": {
    "architect": {
      "provider": "moonshot",
      "model": "kimi-2.6",
      "api_key": "{env:KIMI_API_KEY}",
      "max_tokens": 4096,
      "temperature": 0.3,
      "context_window": 128000
    },
    "worker": {
      "provider": "ollama",
      "model": "gemma2:2b",
      "note": "Local tasks only"
    }
  }
}
