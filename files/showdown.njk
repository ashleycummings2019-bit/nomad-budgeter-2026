---
layout: base.njk
---
{%- set d = showdowns[slug] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ d.city_a }} vs {{ d.city_b }} for Digital Nomads: 2026 Full Comparison | NomadBudgeter</title>
  <meta name="description" content="{{ d.tagline }}">
  <meta name="author" content="Nomad Budgeter">
  <meta name="last-modified" content="{{ d.last_verified }}">
  <link rel="canonical" href="https://nomadbudgeter.com/compare/city/{{ d.slug }}/">
  <meta property="og:title" content="{{ d.city_a }} vs {{ d.city_b }} Digital Nomad Guide 2026 | NomadBudgeter">
  <meta property="og:description" content="{{ d.tagline }}">
  <meta property="og:image" content="https://nomadbudgeter.com/img/og-compare-{{ d.slug }}.jpg">
  <meta property="og:url" content="https://nomadbudgeter.com/compare/city/{{ d.slug }}/">
  <meta property="og:type" content="article">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ d.city_a }} vs {{ d.city_b }} 2026 | NomadBudgeter">
  <meta name="twitter:description" content="{{ d.tagline }}">
  <meta name="twitter:site" content="@nomadbudgeter">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ d.city_a }} vs {{ d.city_b }} for Digital Nomads: 2026 Full Comparison",
    "description": "{{ d.tagline }}",
    "dateModified": "2026-05-01",
    "author": { "@type": "Organization", "name": "Nomad Budgeter" },
    "publisher": {
      "@type": "Organization",
      "name": "Nomad Budgeter",
      "url": "https://nomadbudgeter.com"
    },
    "mainEntityOfPage": "https://nomadbudgeter.com/compare/city/{{ d.slug }}/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in d.faqs %}
      {
        "@type": "Question",
        "name": "{{ faq.q | escape }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.a | escape }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
  <style>
    :root {
      --aura-bg:       #080c14;
      --aura-surface:  rgba(255,255,255,0.04);
      --aura-border:   rgba(255,255,255,0.08);
      --aura-text:     #e8edf5;
      --aura-muted:    #8a94a8;
      --aura-accent:   #6c8fff;
      --aura-green:    #3dffa0;
      --aura-amber:    #ffb740;
      --aura-red:      #ff5c7a;
      --aura-glow-a:   rgba(108,143,255,0.15);
      --aura-glow-b:   rgba(61,255,160,0.12);
      --font-display:  'Syne', sans-serif;
      --font-body:     'DM Sans', sans-serif;
      --radius-lg:     20px;
      --radius-md:     12px;
      --radius-sm:     8px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--aura-bg);
      color: var(--aura-text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ─── BACKGROUND MESH ─── */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 80% 50% at 20% 10%, rgba(108,143,255,0.09) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 80%, rgba(61,255,160,0.07) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 60% 40%, rgba(255,183,64,0.04) 0%, transparent 60%);
    }

    /* ─── LAYOUT ─── */
    .page-wrap { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding: 0 24px; }

    /* ─── BREADCRUMB ─── */
    .breadcrumb {
      display: flex; align-items: center; gap: 8px;
      padding: 28px 0 0;
      font-size: 13px; color: var(--aura-muted);
    }
    .breadcrumb a { color: var(--aura-muted); text-decoration: none; transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--aura-accent); }
    .breadcrumb .sep { opacity: 0.4; }

    /* ─── HERO ─── */
    .hero {
      padding: 56px 0 40px;
      text-align: center;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(108,143,255,0.1);
      border: 1px solid rgba(108,143,255,0.25);
      border-radius: 100px;
      padding: 6px 16px;
      font-size: 12px; font-weight: 600; letter-spacing: 0.08em;
      color: var(--aura-accent); text-transform: uppercase;
      margin-bottom: 28px;
    }
    .hero-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--aura-accent); animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }
    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .hero-title .vs {
      display: inline-block;
      font-size: 0.55em;
      font-weight: 600;
      color: var(--aura-muted);
      margin: 0 12px;
      vertical-align: middle;
    }
    .hero-title .city-a { color: var(--aura-accent); }
    .hero-title .city-b { color: var(--aura-green); }
    .hero-subtitle {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--aura-muted);
      margin-bottom: 16px;
      letter-spacing: 0.03em;
    }
    .hero-tagline {
      max-width: 620px; margin: 0 auto 40px;
      font-size: 1.05rem; color: #9aa5bc; line-height: 1.7;
    }

    /* ─── HEADLINE STATS ─── */
    .stat-strip {
      display: grid; grid-template-columns: 1fr auto 1fr;
      gap: 16px; max-width: 720px; margin: 0 auto 56px;
      align-items: center;
    }
    .stat-card {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-lg);
      padding: 24px 20px;
      text-align: center;
      backdrop-filter: blur(12px);
      transition: border-color 0.3s, transform 0.3s;
    }
    .stat-card:hover { border-color: rgba(255,255,255,0.15); transform: translateY(-2px); }
    .stat-card.city-a-card { border-color: rgba(108,143,255,0.25); }
    .stat-card.city-b-card { border-color: rgba(61,255,160,0.2); }
    .stat-flag { font-size: 2.4rem; margin-bottom: 8px; line-height: 1; }
    .stat-city { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; margin-bottom: 4px; }
    .city-a-card .stat-city { color: var(--aura-accent); }
    .city-b-card .stat-city { color: var(--aura-green); }
    .stat-country { font-size: 0.8rem; color: var(--aura-muted); margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.06em; }
    .stat-big { font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
    .stat-label { font-size: 0.78rem; color: var(--aura-muted); }
    .vs-divider { text-align: center; }
    .vs-pill {
      display: inline-block;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--aura-border);
      border-radius: 100px;
      padding: 10px 18px;
      font-family: var(--font-display); font-size: 1rem; font-weight: 700;
      color: var(--aura-muted);
    }

    /* ─── WINNER BANNER ─── */
    .winner-banner {
      background: linear-gradient(135deg, rgba(61,255,160,0.08) 0%, rgba(108,143,255,0.06) 100%);
      border: 1px solid rgba(61,255,160,0.2);
      border-radius: var(--radius-lg);
      padding: 24px 32px;
      display: flex; align-items: flex-start; gap: 20px;
      margin-bottom: 64px;
    }
    .winner-icon { font-size: 2.4rem; flex-shrink: 0; margin-top: 2px; }
    .winner-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--aura-green); font-weight: 700; margin-bottom: 6px; }
    .winner-title { font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin-bottom: 8px; }
    .winner-reason { color: #9aa5bc; font-size: 0.95rem; line-height: 1.6; }

    /* ─── SECTION HEADINGS ─── */
    .section { margin-bottom: 72px; }
    .section-label {
      display: inline-block;
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--aura-accent); margin-bottom: 12px;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700; line-height: 1.2;
      margin-bottom: 8px;
    }
    .section-desc { color: var(--aura-muted); font-size: 0.95rem; margin-bottom: 32px; max-width: 560px; }

    /* ─── WINNER PILLS ROW ─── */
    .winner-pills {
      display: flex; flex-wrap: wrap; gap: 10px;
      margin-bottom: 40px;
    }
    .winner-pill {
      display: flex; align-items: center; gap: 8px;
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: 100px; padding: 8px 16px;
      font-size: 0.82rem;
    }
    .winner-pill .label { color: var(--aura-muted); }
    .winner-pill .value { font-weight: 600; }
    .winner-pill .value.a { color: var(--aura-accent); }
    .winner-pill .value.b { color: var(--aura-green); }
    .winner-pill .value.draw { color: var(--aura-amber); }

    /* ─── COMPARISON TABLE ─── */
    .compare-table {
      width: 100%; border-collapse: collapse;
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-lg); overflow: hidden;
      backdrop-filter: blur(12px);
    }
    .compare-table thead { background: rgba(255,255,255,0.03); }
    .compare-table th {
      padding: 16px 20px;
      font-family: var(--font-display); font-size: 0.85rem; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      text-align: left; color: var(--aura-muted);
      border-bottom: 1px solid var(--aura-border);
    }
    .compare-table th.th-a { color: var(--aura-accent); }
    .compare-table th.th-b { color: var(--aura-green); }
    .compare-table td {
      padding: 14px 20px;
      font-size: 0.92rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      vertical-align: top;
    }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:hover td { background: rgba(255,255,255,0.02); }
    .compare-table .row-label { color: var(--aura-muted); font-size: 0.82rem; font-weight: 500; }
    .compare-table .val-a { color: var(--aura-text); }
    .compare-table .val-b { color: var(--aura-text); }
    .winner-star { display: inline-block; margin-left: 6px; font-size: 0.75em; }

    /* ─── TAX DEEP DIVE ─── */
    .tax-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 20px; margin-bottom: 32px;
    }
    @media(max-width:600px) { .tax-grid { grid-template-columns: 1fr; } }
    .tax-card {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      backdrop-filter: blur(12px);
      transition: border-color 0.3s;
    }
    .tax-card.a { border-top: 3px solid var(--aura-accent); }
    .tax-card.b { border-top: 3px solid var(--aura-green); }
    .tax-flag { font-size: 1.8rem; margin-bottom: 12px; }
    .tax-city { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
    .tax-card.a .tax-city { color: var(--aura-accent); }
    .tax-card.b .tax-city { color: var(--aura-green); }
    .tax-regime { font-size: 0.82rem; color: var(--aura-muted); margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.06em; }
    .tax-rate-big {
      font-family: var(--font-display);
      font-size: 3rem; font-weight: 800; line-height: 1;
      margin-bottom: 4px;
    }
    .tax-card.a .tax-rate-big { color: var(--aura-accent); }
    .tax-card.b .tax-rate-big { color: var(--aura-green); }
    .tax-duration { font-size: 0.82rem; color: var(--aura-muted); margin-bottom: 20px; }
    .tax-notes {
      font-size: 0.83rem; color: #8a94a8; line-height: 1.6;
      padding: 12px 14px;
      background: rgba(0,0,0,0.2);
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--aura-border);
    }
    .tax-source { font-size: 0.75rem; color: var(--aura-muted); margin-top: 12px; opacity: 0.7; }

    /* ─── VISA SECTION ─── */
    .visa-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media(max-width:600px) { .visa-grid { grid-template-columns: 1fr; } }
    .visa-card {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      backdrop-filter: blur(12px);
    }
    .visa-card.a { border-top: 3px solid var(--aura-accent); }
    .visa-card.b { border-top: 3px solid var(--aura-green); }
    .visa-name { font-family: var(--font-display); font-size: 1rem; font-weight: 700; margin-bottom: 20px; }
    .visa-card.a .visa-name { color: var(--aura-accent); }
    .visa-card.b .visa-name { color: var(--aura-green); }
    .visa-row {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 12px; padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.88rem;
    }
    .visa-row:last-of-type { border-bottom: none; }
    .visa-row-label { color: var(--aura-muted); flex-shrink: 0; }
    .visa-row-val { font-weight: 500; text-align: right; }
    .visa-note-2026 {
      margin-top: 16px;
      font-size: 0.8rem; color: var(--aura-amber);
      background: rgba(255,183,64,0.06);
      border: 1px solid rgba(255,183,64,0.2);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      line-height: 1.5;
    }
    .visa-note-2026::before { content: "⚠ 2026 Update: "; font-weight: 700; }

    /* ─── PICK LIST ─── */
    .pick-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media(max-width:640px) { .pick-grid { grid-template-columns: 1fr; } }
    .pick-card {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      backdrop-filter: blur(12px);
    }
    .pick-card.a { border-top: 3px solid var(--aura-accent); }
    .pick-card.b { border-top: 3px solid var(--aura-green); }
    .pick-header {
      display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
    }
    .pick-flag { font-size: 1.6rem; }
    .pick-title { font-family: var(--font-display); font-size: 1rem; font-weight: 700; }
    .pick-card.a .pick-title { color: var(--aura-accent); }
    .pick-card.b .pick-title { color: var(--aura-green); }
    .pick-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .pick-list li {
      display: flex; gap: 10px; align-items: flex-start;
      font-size: 0.9rem; line-height: 1.5; color: #b0bac9;
    }
    .pick-list li::before {
      content: '→';
      flex-shrink: 0;
      font-weight: 700;
      margin-top: 1px;
    }
    .pick-card.a .pick-list li::before { color: var(--aura-accent); }
    .pick-card.b .pick-list li::before { color: var(--aura-green); }

    /* ─── CALCULATOR CTA ─── */
    .calc-cta {
      background: linear-gradient(135deg, rgba(108,143,255,0.1) 0%, rgba(61,255,160,0.07) 100%);
      border: 1px solid rgba(108,143,255,0.2);
      border-radius: var(--radius-lg);
      padding: 40px;
      text-align: center;
      margin-bottom: 72px;
    }
    .calc-cta h3 {
      font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
      margin-bottom: 12px;
    }
    .calc-cta p { color: var(--aura-muted); max-width: 440px; margin: 0 auto 28px; font-size: 0.95rem; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--aura-accent);
      color: #fff; font-weight: 700; font-size: 0.95rem;
      padding: 14px 28px; border-radius: 100px;
      text-decoration: none; transition: all 0.2s;
      border: none; cursor: pointer;
    }
    .btn-primary:hover { background: #7fa0ff; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(108,143,255,0.3); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      background: transparent;
      color: var(--aura-text); font-weight: 600; font-size: 0.9rem;
      padding: 12px 24px; border-radius: 100px;
      text-decoration: none; transition: all 0.2s;
      border: 1px solid var(--aura-border);
      margin-left: 12px;
    }
    .btn-secondary:hover { border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.04); }

    /* ─── FAQ ─── */
    .faq-list { display: flex; flex-direction: column; gap: 4px; }
    .faq-item {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .faq-item:hover { border-color: rgba(255,255,255,0.12); }
    .faq-q {
      padding: 20px 24px;
      font-weight: 600; font-size: 0.95rem; cursor: pointer;
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      list-style: none;
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-q::after { content: '+'; color: var(--aura-accent); font-size: 1.4rem; font-weight: 300; flex-shrink: 0; transition: transform 0.2s; }
    details[open] .faq-q::after { transform: rotate(45deg); }
    .faq-a {
      padding: 0 24px 20px;
      font-size: 0.9rem; color: #9aa5bc; line-height: 1.7;
      border-top: 1px solid rgba(255,255,255,0.04);
      padding-top: 16px;
    }

    /* ─── DATA SOURCES ─── */
    .sources-block {
      background: rgba(0,0,0,0.2);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-top: 32px;
    }
    .sources-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--aura-muted); font-weight: 700; margin-bottom: 12px; }
    .sources-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .sources-list li { font-size: 0.8rem; color: var(--aura-muted); display: flex; gap: 8px; }
    .sources-list li::before { content: '↗'; color: var(--aura-accent); flex-shrink: 0; }
    .last-verified { font-size: 0.78rem; color: var(--aura-muted); margin-top: 10px; }
    .last-verified span { color: var(--aura-green); font-weight: 600; }

    /* ─── RELATED ─── */
    .related-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr));
      gap: 12px;
    }
    .related-card {
      background: var(--aura-surface);
      border: 1px solid var(--aura-border);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      text-decoration: none; color: var(--aura-text);
      transition: all 0.2s;
      display: flex; flex-direction: column; gap: 6px;
    }
    .related-card:hover { border-color: rgba(108,143,255,0.3); transform: translateY(-2px); background: rgba(255,255,255,0.06); }
    .related-card .rc-flags { font-size: 1.2rem; }
    .related-card .rc-title { font-weight: 600; font-size: 0.9rem; }
    .related-card .rc-sub { font-size: 0.78rem; color: var(--aura-muted); }

    /* ─── RESPONSIVE ─── */
    @media(max-width:768px) {
      .stat-strip { grid-template-columns: 1fr; }
      .vs-divider { display: none; }
      .winner-banner { flex-direction: column; padding: 20px; }
      .tax-grid, .visa-grid, .pick-grid { grid-template-columns: 1fr; }
      .calc-cta { padding: 28px 20px; }
      .btn-secondary { margin-left: 0; margin-top: 10px; display: block; text-align: center; }
      table { font-size: 0.82rem; }
      .compare-table th, .compare-table td { padding: 10px 12px; }
    }
  </style>
</head>
<body>

  {# ─── NAV (uses existing site nav include) ─── #}
  {% include "partials/nav.njk" %}

  <main class="page-wrap">

    {# ─── BREADCRUMB ─── #}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">🌍 NomadBudgeter</a>
      <span class="sep">›</span>
      <a href="/compare/">Compare</a>
      <span class="sep">›</span>
      <span>{{ d.city_a }} vs {{ d.city_b }}</span>
    </nav>

    {# ─── HERO ─── #}
    <header class="hero">
      <div class="hero-badge">
        <span class="dot"></span>
        2026 Real Data · {{ d.subtitle }}
      </div>
      <h1 class="hero-title">
        <span class="city-a">{{ d.emoji_a }} {{ d.city_a }}</span>
        <span class="vs">VS</span>
        <span class="city-b">{{ d.city_b }} {{ d.emoji_b }}</span>
      </h1>
      <p class="hero-subtitle">{{ d.subtitle }}</p>
      <p class="hero-tagline">{{ d.tagline }}</p>
    </header>

    {# ─── STAT STRIP ─── #}
    <div class="stat-strip">
      <div class="stat-card city-a-card">
        <div class="stat-flag">{{ d.emoji_a }}</div>
        <div class="stat-city">{{ d.city_a }}</div>
        <div class="stat-country">{{ d.country_a }}</div>
        <div class="stat-big">{{ d.hero_stat_a }}</div>
        <div class="stat-label">{{ d.hero_label }}</div>
      </div>
      <div class="vs-divider">
        <div class="vs-pill">VS</div>
      </div>
      <div class="stat-card city-b-card">
        <div class="stat-flag">{{ d.emoji_b }}</div>
        <div class="stat-city">{{ d.city_b }}</div>
        <div class="stat-country">{{ d.country_b }}</div>
        <div class="stat-big">{{ d.hero_stat_b }}</div>
        <div class="stat-label">{{ d.hero_label }}</div>
      </div>
    </div>

    {# ─── VERDICT ─── #}
    <div class="winner-banner">
      <div class="winner-icon">🏆</div>
      <div>
        <div class="winner-label">Overall Verdict 2026</div>
        <div class="winner-title">Winner: {{ d.verdict }}</div>
        <div class="winner-reason">{{ d.verdict_reason }}</div>
      </div>
    </div>

    {# ─── CATEGORY WINNERS ─── #}
    <section class="section">
      <div class="section-label">Quick Summary</div>
      <h2 class="section-title">Category Winners</h2>
      <div class="winner-pills">
        <div class="winner-pill">
          <span class="label">💰 Cost of Living:</span>
          <span class="value {% if d.cost_winner == d.city_a %}a{% elif d.cost_winner == d.city_b %}b{% else %}draw{% endif %}">{{ d.cost_winner }}</span>
        </div>
        <div class="winner-pill">
          <span class="label">📊 Tax Regime:</span>
          <span class="value {% if d.tax_winner == d.city_a %}a{% elif d.tax_winner == d.city_b %}b{% else %}draw{% endif %}">{{ d.tax_winner }}</span>
        </div>
        <div class="winner-pill">
          <span class="label">🛂 Visa Access:</span>
          <span class="value {% if d.visa_winner == d.city_a %}a{% elif d.visa_winner == d.city_b %}b{% else %}draw{% endif %}">{{ d.visa_winner }}</span>
        </div>
        <div class="winner-pill">
          <span class="label">🌅 Lifestyle:</span>
          <span class="value {% if d.lifestyle_winner == d.city_a %}a{% elif d.lifestyle_winner == d.city_b %}b{% else %}draw{% endif %}">{{ d.lifestyle_winner }}</span>
        </div>
      </div>

      {# ─── MAIN COST TABLE ─── #}
      <div style="overflow-x:auto;">
        <table class="compare-table" aria-label="Cost of living comparison {{ d.city_a }} vs {{ d.city_b }}">
          <thead>
            <tr>
              <th>Category</th>
              <th class="th-a">{{ d.emoji_a }} {{ d.city_a }}</th>
              <th class="th-b">{{ d.emoji_b }} {{ d.city_b }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-label">1BR Apartment (Central)</td>
              <td class="val-a">{{ d.costs_a.rent_1br }}/mo {% if d.cost_winner == d.city_a %}<span class="winner-star" title="Lower cost">✦</span>{% endif %}</td>
              <td class="val-b">{{ d.costs_b.rent_1br }}/mo {% if d.cost_winner == d.city_b %}<span class="winner-star" title="Lower cost">✦</span>{% endif %}</td>
            </tr>
            <tr>
              <td class="row-label">Meal at Local Restaurant</td>
              <td class="val-a">{{ d.costs_a.meal_local }}</td>
              <td class="val-b">{{ d.costs_b.meal_local }}</td>
            </tr>
            <tr>
              <td class="row-label">Coworking (hot desk/mo)</td>
              <td class="val-a">{{ d.costs_a.coworking }}</td>
              <td class="val-b">{{ d.costs_b.coworking }}</td>
            </tr>
            <tr>
              <td class="row-label">Coffee (flat white)</td>
              <td class="val-a">{{ d.costs_a.coffee }}</td>
              <td class="val-b">{{ d.costs_b.coffee }}</td>
            </tr>
            <tr>
              <td class="row-label">Groceries (monthly)</td>
              <td class="val-a">{{ d.costs_a.groceries_mo }}</td>
              <td class="val-b">{{ d.costs_b.groceries_mo }}</td>
            </tr>
            <tr>
              <td class="row-label">Transport (monthly)</td>
              <td class="val-a">{{ d.costs_a.transport_mo }}</td>
              <td class="val-b">{{ d.costs_b.transport_mo }}</td>
            </tr>
            <tr>
              <td class="row-label">Internet Speed</td>
              <td class="val-a">{{ d.costs_a.internet_speed }}</td>
              <td class="val-b">{{ d.costs_b.internet_speed }}</td>
            </tr>
            <tr>
              <td class="row-label">Tax Regime</td>
              <td class="val-a">{{ d.tax_a.rate }} {% if d.tax_winner == d.city_a %}<span class="winner-star">✦</span>{% endif %}</td>
              <td class="val-b">{{ d.tax_b.rate }} {% if d.tax_winner == d.city_b %}<span class="winner-star">✦</span>{% endif %}</td>
            </tr>
            <tr>
              <td class="row-label">Visa Income Requirement</td>
              <td class="val-a">{{ d.visa_a.income_req }} {% if d.visa_winner == d.city_a %}<span class="winner-star">✦</span>{% endif %}</td>
              <td class="val-b">{{ d.visa_b.income_req }} {% if d.visa_winner == d.city_b %}<span class="winner-star">✦</span>{% endif %}</td>
            </tr>
            <tr>
              <td class="row-label">Visa Duration</td>
              <td class="val-a">{{ d.visa_a.duration }}</td>
              <td class="val-b">{{ d.visa_b.duration }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    {# ─── TAX DEEP DIVE ─── #}
    <section class="section">
      <div class="section-label">Tax Intelligence</div>
      <h2 class="section-title">Tax Regime Deep Dive</h2>
      <p class="section-desc">Verified 2026 rates. Always confirm your personal position with a qualified tax advisor.</p>
      <div class="tax-grid">
        <div class="tax-card a">
          <div class="tax-flag">{{ d.emoji_a }}</div>
          <div class="tax-city">{{ d.city_a }}, {{ d.country_a }}</div>
          <div class="tax-regime">{{ d.tax_a.regime }}</div>
          <div class="tax-rate-big">{{ d.tax_a.rate }}</div>
          <div class="tax-duration">Duration: {{ d.tax_a.duration }}</div>
          <div class="tax-notes">{{ d.tax_a.notes }}</div>
          <div class="tax-source">Source: {{ d.tax_a.source }}</div>
        </div>
        <div class="tax-card b">
          <div class="tax-flag">{{ d.emoji_b }}</div>
          <div class="tax-city">{{ d.city_b }}, {{ d.country_b }}</div>
          <div class="tax-regime">{{ d.tax_b.regime }}</div>
          <div class="tax-rate-big">{{ d.tax_b.rate }}</div>
          <div class="tax-duration">Duration: {{ d.tax_b.duration }}</div>
          <div class="tax-notes">{{ d.tax_b.notes }}</div>
          <div class="tax-source">Source: {{ d.tax_b.source }}</div>
        </div>
      </div>

      {# ─── CALCULATOR EMBED ─── #}
      <div class="calc-cta">
        <h3>Calculate Your Exact Net Income</h3>
        <p>Run your real numbers through our 2026 tax engine. See your take-home pay in {{ d.city_a }} vs {{ d.city_b }} side by side.</p>
        <a class="btn-primary" href="/?city={{ d.city_a | lower | replace(' ', '-') }}">
          ⚡ Open Tax Calculator
        </a>
        <a class="btn-secondary" href="/pricing/">Unlock Pro Report →</a>
      </div>
    </section>

    {# ─── VISA SECTION ─── #}
    <section class="section">
      <div class="section-label">Visa Intelligence</div>
      <h2 class="section-title">2026 Visa Comparison</h2>
      <p class="section-desc">Requirements verified as of {{ d.last_verified }}. Immigration rules change — verify with an immigration attorney before applying.</p>
      <div class="visa-grid">
        <div class="visa-card a">
          <div class="visa-name">{{ d.emoji_a }} {{ d.visa_a.name }}</div>
          <div class="visa-row">
            <span class="visa-row-label">Income Requirement</span>
            <span class="visa-row-val">{{ d.visa_a.income_req }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Duration</span>
            <span class="visa-row-val">{{ d.visa_a.duration }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Application Cost</span>
            <span class="visa-row-val">{{ d.visa_a.cost }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Processing Time</span>
            <span class="visa-row-val">{{ d.visa_a.processing }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Residency Path</span>
            <span class="visa-row-val">{{ d.visa_a.path_to_residency }}</span>
          </div>
        </div>
        <div class="visa-card b">
          <div class="visa-name">{{ d.emoji_b }} {{ d.visa_b.name }}</div>
          <div class="visa-row">
            <span class="visa-row-label">Income Requirement</span>
            <span class="visa-row-val">{{ d.visa_b.income_req }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Duration</span>
            <span class="visa-row-val">{{ d.visa_b.duration }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Application Cost</span>
            <span class="visa-row-val">{{ d.visa_b.cost }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Processing Time</span>
            <span class="visa-row-val">{{ d.visa_b.processing }}</span>
          </div>
          <div class="visa-row">
            <span class="visa-row-label">Residency Path</span>
            <span class="visa-row-val">{{ d.visa_b.path_to_residency }}</span>
          </div>
          {% if d.visa_b.note_2026 %}
          <div class="visa-note-2026">{{ d.visa_b.note_2026 }}</div>
          {% endif %}
        </div>
      </div>
    </section>

    {# ─── WHO SHOULD PICK WHICH ─── #}
    <section class="section">
      <div class="section-label">Decision Guide</div>
      <h2 class="section-title">Which City Is Right for You?</h2>
      <p class="section-desc">Based on income level, lifestyle, and visa goals.</p>
      <div class="pick-grid">
        <div class="pick-card a">
          <div class="pick-header">
            <span class="pick-flag">{{ d.emoji_a }}</span>
            <span class="pick-title">Pick {{ d.city_a }} if…</span>
          </div>
          <ul class="pick-list">
            {% for item in d.pick_a_if %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="pick-card b">
          <div class="pick-header">
            <span class="pick-flag">{{ d.emoji_b }}</span>
            <span class="pick-title">Pick {{ d.city_b }} if…</span>
          </div>
          <ul class="pick-list">
            {% for item in d.pick_b_if %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

    {# ─── FAQ ─── #}
    <section class="section">
      <div class="section-label">FAQ</div>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {% for faq in d.faqs %}
        <details class="faq-item">
          <summary class="faq-q">{{ faq.q }}</summary>
          <div class="faq-a">{{ faq.a }}</div>
        </details>
        {% endfor %}
      </div>

      {# ─── DATA SOURCES ─── #}
      <div class="sources-block">
        <div class="sources-title">Data Sources & Methodology</div>
        <ul class="sources-list">
          {% for src in d.data_sources %}
          <li>{{ src }}</li>
          {% endfor %}
        </ul>
        <p class="last-verified">All data last verified: <span>{{ d.last_verified }}</span>. Calculations are for informational purposes only and do not constitute professional tax or legal advice.</p>
      </div>
    </section>

    {# ─── RELATED COMPARISONS ─── #}
    <section class="section">
      <div class="section-label">Explore More</div>
      <h2 class="section-title">More City Showdowns</h2>
      <div class="related-grid">
        {% set all_slugs = showdowns | keys %}
        {% for rel_slug in all_slugs %}
          {% if rel_slug != d.slug %}
          {% set r = showdowns[rel_slug] %}
          <a href="/compare/city/{{ r.slug }}/" class="related-card">
            <div class="rc-flags">{{ r.emoji_a }}{{ r.emoji_b }}</div>
            <div class="rc-title">{{ r.city_a }} vs {{ r.city_b }}</div>
            <div class="rc-sub">{{ r.subtitle }}</div>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </section>

  </main>

  {# ─── FOOTER (uses existing site footer include) ─── #}
  {% include "partials/footer.njk" %}

</body>
</html>
